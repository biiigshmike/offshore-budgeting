          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@. مجموع مبالغ الفئات المعروضة أدناه يساوي إجمالي الفترة في الرسم البياني."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@. Die unten angezeigten Kategorien ergeben zusammen die Diagrammsumme für diesen Zeitraum."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "%1$@: %2$@. The displayed categories below add up to the chart total for this period."

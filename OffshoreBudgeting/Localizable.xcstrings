    "Category for %@" : {
      "comment" : "The accessibility label for the category picker in the \"Review Expenses\" view. The argument is the name of the expense.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "فئة %@"

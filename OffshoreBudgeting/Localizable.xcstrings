    "You can import one file at a time (CSV, PDF, or image) from Files or Photos. Expense rows are skipped in Income import." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك استيراد ملف واحد في كل مرة (CSV أو PDF أو صورة) من «الملفات» أو «الصور». يتم تخطي صفوف النفقات عند استيراد الدخل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können jeweils eine Datei (CSV, PDF oder Bild) aus „Dateien“ oder „Fotos“ importieren. Beim Import von Einnahmen werden Zeilen mit Ausgaben übersprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes importar un archivo a la vez (CSV, PDF o imagen) desde Archivos o Fotos. Al importar ingresos, se omiten las filas de gastos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez importer un fichier à la fois (CSV, PDF ou image) depuis Fichiers ou Photos. Les lignes de dépenses sont ignorées lors de l’importation des revenus."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode importar um arquivo por vez (CSV, PDF ou imagem) de Arquivos ou Fotos. As linhas de despesas são ignoradas na importação de renda."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "每次可从“文件”或“照片”中导入一个文件（CSV、PDF 或图片）。导入收入时会跳过费用行。"
          }
        }
      }
    },

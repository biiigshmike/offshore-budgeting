            "state" : "translated",
            "value" : "يتخطّى «استيراد الدخل» صفوف النفقات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Einkommen importieren“ überspringt Zeilen mit Ausgaben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Importar ingresos» omite las filas de gastos."
          }
        },
        "fr" : {

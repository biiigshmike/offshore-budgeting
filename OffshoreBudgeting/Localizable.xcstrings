    "Set Aside as Savings" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تخصيص مبلغ للادخار"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Als Ersparnis zurücklegen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reservar como ahorro"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettre de côté comme épargne"
          }
        },

    "All reminders use this time. If needed, the next step asks for system permission to send notifications." : {
      "comment" : "A description of the reminder time.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم جميع التذكيرات هذا الوقت. إذا لزم الأمر، سيطلب منك النظام في الخطوة التالية السماح بإرسال الإشعارات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Uhrzeit gilt für alle Erinnerungen. Falls nötig, werden Sie im nächsten Schritt gebeten, Benachrichtigungen zu erlauben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos los recordatorios usan esta hora. Si hace falta, en el siguiente paso se solicitará permiso para enviar notificaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette heure s’applique à tous les rappels. Si nécessaire, l’étape suivante vous demandera d’autoriser les notifications."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todos os lembretes usam este horário. Se necessário, na próxima etapa o sistema pedirá permissão para enviar notificações."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "所有提醒都使用此时间。如有需要，下一步会请求系统通知权限。"
          }
        }
      }
    },
    "All Time" : {

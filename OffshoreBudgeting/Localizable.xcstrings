    "Offshore reflects Apple’s on-device permission system status." : {
      "comment" : "A description of the permission system.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض Offshore حالة الأذونات كما يحددها نظام Apple على الجهاز."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offshore zeigt den von Apple auf diesem Gerät gemeldeten Berechtigungsstatus an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offshore muestra el estado de los permisos que gestiona Apple en el dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offshore affiche l’état des autorisations communiqué par le système Apple sur cet appareil."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Offshore exibe o status das permissões gerenciadas pela Apple no dispositivo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offshore 显示 Apple 设备系统中的权限状态。"
          }
        }
      }
    },
    "Offshore reflects Apple’s on-device permission system status. You can change any permission at any time in App Settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعكس Offshore حالة نظام الأذونات على الجهاز من Apple. يمكنك تغيير أي إذن في أي وقت في إعدادات التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offshore spiegelt den Status des Apple-Berechtigungssystems auf dem Gerät wider."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offshore refleja el estado del sistema de permisos en el dispositivo de Apple. Puedes cambiar cualquier permiso en cualquier momento desde Ajustes de la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offshore reflects Apple’s on-device permission system status. You can change any permission at any time in App Réglages."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offshore reflete o status do sistema de permissão no dispositivo da Apple. Você pode alterar qualquer permissão a qualquer momento nas configurações do aplicativo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offshore反映了苹果设备上的权限系统状态。您可以随时在应用程序设置中更改任何权限。"
          }
        }
      }
    },

    "Manage credit cards, checking accounts, or cash. Open a card to track spending, add expenses, and review its activity." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدر بطاقات الائتمان أو الحسابات الجارية أو النقد. افتح بطاقة لتتبع الإنفاق وإضافة المصروفات ومراجعة نشاطها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwalten Sie Kreditkarten, Girokonten oder Bargeld. Öffnen Sie eine Karte, um Ausgaben zu verfolgen, hinzuzufügen und ihre Aktivitäten zu prüfen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gestiona tarjetas de crédito, cuentas corrientes o efectivo. Abre una tarjeta para seguir gastos, añadir movimientos y revisar su actividad."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gérez cartes de crédit, comptes courants ou espèces. Ouvrez une carte pour suivre les dépenses, en ajouter et consulter son activité."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gerencie cartões de crédito, contas correntes ou dinheiro. Abra um cartão para acompanhar gastos, adicionar despesas e revisar a atividade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理信用卡、支票账户或现金。打开卡片即可跟踪支出、添加支出并查看活动。"
          }
        }
      }
    },

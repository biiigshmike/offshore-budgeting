    "notification.dailyExpense.body" : {
      "comment" : "Daily reminder notification body for logging expenses.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حافظ على الكتب مرتبة ومتوازنة. سجل أي نفقات متغيرة اليوم."
          }
        },
        "de" : {
          "stringUnit" : {

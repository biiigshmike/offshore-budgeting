    "Adjustment budget impact" : {
      "comment" : "Text describing the budget impact of adjustments.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أثر التعديلات على الميزانية"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budgetbelastung durch Anpassungen"
          }
        },
        "es" : {
          "stringUnit" : {

          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offshore addiert die geplanten und variablen Ausgaben dieser Kategorie, nachdem geteilte Ausgabenanteile, „Bezahlen Sie mit Ersparnissen“ und Rückerstattungen abgezogen wurden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

    "%@: %@. The displayed categories below add up to the chart total for this period." : {
      "comment" : "The title of the section that lists the spending by category for a single period. The first argument is the period's label. The second argument is the string “%1$arg – %2$arg”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {

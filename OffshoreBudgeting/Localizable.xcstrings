    "Top: %@, %@. This is the largest displayed category in the highest spending period, which may be Other or Uncategorized." : {
      "comment" : "Text displayed in the spending trends section of the spending calculation. The first argument is the name of the category. The second argument is the amount in the category.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعلى فئة: %1$@، %2$@. هذه هي أكبر فئة معروضة في فترة الإنفاق الأعلى، وقد تكون «أخرى» أو «غير مصنف»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Oben: %1$@, %2$@. Dies ist die größte angezeigte Kategorie im Zeitraum mit den höchsten Ausgaben. Das kann auch „Sonstige“ oder „Nicht kategorisiert“ sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Top: %1$@, %2$@. This is the largest displayed category in the highest spending period, which may be Other or Uncategorized."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Principal: %1$@, %2$@. Es la categoría con mayor gasto que aparece en el período de mayor gasto. Puede ser «Otras» o «Sin categoría»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Top : %1$@, %2$@. C’est la catégorie affichée la plus importante de la période où les dépenses sont les plus élevées. Il peut s’agir de « Autres » ou de « Non catégorisé »."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Superior: %1$@, %2$@. É a maior categoria exibida no período de maior gasto. Pode ser “Outras” ou “Sem categoria”."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "顶部：%1$@，%2$@。这是支出最高期间内显示的金额最大的类别，可能是“其他”或“未分类”。"
          }
        }
      }
    },

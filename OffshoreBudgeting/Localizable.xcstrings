            "state" : "translated",
            "value" : "Zukünftig geplante Ausgaben ausblenden"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar gastos planificados futuros"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Masquer les dépenses prévues futures"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ocultar despesas futuras planejadas"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "隐藏未来计划费用"
          }
        }
      }
    },
    "Hide Future Variable Expenses" : {
      "localizations" : {
        "ar" : {

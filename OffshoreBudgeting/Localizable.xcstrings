    "Near %@? Record an expense if you made a purchase." : {
      "comment" : "Text displayed in a notification when a user is near a specific merchant and can record an expense. The argument is the merchant name.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {

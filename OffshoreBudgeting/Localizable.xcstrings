    "Offshore couldn’t save your changes. Try switching storage again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تعذّر على Offshore حفظ تغييراتك. حاول تغيير طريقة التخزين مرة أخرى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offshore konnte Ihre Änderungen nicht speichern. Versuchen Sie erneut, den Speicherort zu wechseln."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offshore no pudo guardar los cambios. Intenta cambiar el almacenamiento de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offshore n’a pas pu enregistrer vos modifications. Réessayez de changer de mode de stockage."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Offshore não conseguiu salvar as alterações. Tente trocar o armazenamento novamente."
          }

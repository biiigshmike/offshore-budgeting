    "Your message is still open. Try again, save the draft, or copy your text before closing it." : {
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تزال رسالتك مفتوحة. حاول مجددًا أو احفظ المسودة أو انسخ نصك قبل إغلاقها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Nachricht ist noch geöffnet. Versuchen Sie es erneut, speichern Sie den Entwurf oder kopieren Sie den Text vor dem Schließen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu mensaje sigue abierto. Inténtalo de nuevo, guarda el borrador o copia el texto antes de cerrarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre message est toujours ouvert. Réessayez, enregistrez le brouillon ou copiez votre texte avant de le fermer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua mensagem ainda está aberta. Tente novamente, salve o rascunho ou copie o texto antes de fechar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的邮件仍然打开。请重试、保存草稿，或在关闭前复制文字。"
          }
        }
      }
    },
    "Your previous Auto-Configure settings were restored. Please try again." : {
      "comment" : "A message displayed when the user can't save their Auto-Configure settings.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تمت استعادة إعدادات الإعداد التلقائي السابقة. يرجى المحاولة مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine vorherigen Einstellungen für die automatische Konfiguration wurden wiederhergestellt. Bitte versuche es erneut."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se han restaurado tus ajustes anteriores de configuración automática. Inténtalo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos précédents réglages de configuration automatique ont été rétablis. Veuillez réessayer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas configurações anteriores de configuração automática foram restauradas. Tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已恢复之前的自动配置设置。请重试。"
          }
        }
      }
    },
    "Your reminder choices are saved, but setup could not finish." : {
      "comment" : "A message displayed when the user's reminder preferences are saved, but setup fails.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حُفظت اختيارات التذكيرات، لكن تعذّر إكمال الإعداد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Auswahl wurde gespeichert, aber die Einrichtung der Erinnerungen konnte nicht abgeschlossen werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardamos tus preferencias de recordatorios, pero no se pudo terminar la configuración."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos choix de rappels sont enregistrés, mais la configuration n’a pas pu aboutir."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas preferências de lembretes foram salvas, mas não foi possível concluir a configuração."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的提醒选项已保存，但未能完成设置。"
          }
        }
      }
    },
    "Your reminder choices are saved. Notifications are blocked in System Settings; you can allow them there, then turn on Send Scheduled Reminders in the app." : {
      "comment" : "A message displayed when the user has saved their reminder preferences but has blocked notifications.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حُفظت اختيارات التذكيرات. الإشعارات محظورة في إعدادات النظام. اسمح بها هناك، ثم فعّل «إرسال التذكيرات المجدولة» في التطبيق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihre Auswahl an Erinnerungen wurde gespeichert. Benachrichtigungen sind in den Systemeinstellungen blockiert. Erlauben Sie sie dort und aktivieren Sie anschließend „Geplante Erinnerungen senden“ in der App."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guardamos tus preferencias de recordatorios. Las notificaciones están bloqueadas en los ajustes del sistema. Permítelas allí y luego activa «Enviar recordatorios programados» en la app."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos choix de rappels sont enregistrés. Les notifications sont bloquées dans les réglages système. Autorisez-les dans ces réglages, puis activez « Envoyer les rappels programmés » dans l’app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas preferências de lembretes foram salvas. As notificações estão bloqueadas nos ajustes do sistema. Você pode permiti-las lá e, depois, ativar “Enviar lembretes programados” no app."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的提醒选项已保存。系统已阻止通知。请先在系统“设置”中允许通知，再在 App 内打开“发送定时提醒”。"
          }
        }
      }
    },
    "Your saved milestones are still shown. Try again in a moment." : {
      "comment" : "A message displayed when the user can't update their workspace progress.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تزال إنجازاتك المحفوظة ظاهرة. حاول مجددًا بعد قليل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine gespeicherten Meilensteine werden weiterhin angezeigt. Versuche es gleich noch einmal."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus hitos guardados siguen visibles. Inténtalo de nuevo en un momento."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos étapes enregistrées sont toujours affichées. Réessayez dans un instant."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus marcos salvos continuam sendo exibidos. Tente novamente em instantes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "已保存的里程碑仍会显示。请稍后重试。"
          }
        }
      }
    },
    "Your selections are still here. Please try saving again." : {
      "comment" : "The body of an alert that appears when the user tries to save their selections but fails.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تزال اختياراتك موجودة. يرجى محاولة الحفظ مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Auswahl ist noch vorhanden. Bitte versuche erneut zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tus selecciones siguen aquí. Intenta guardarlas de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vos sélections sont toujours présentes. Essayez à nouveau de les enregistrer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suas seleções continuam aqui. Tente salvar novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的选择仍然保留。请再次尝试保存。"
          }
        }
      }
    },
    "Your tip is awaiting approval. Thank you! Apple will complete it once approved." : {
      "comment" : "Message displayed when a tip is pending approval from Apple.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مساهمتك قيد الموافقة. شكرًا لك! ستُكمل Apple العملية بعد الموافقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ihr Trinkgeld wartet auf Genehmigung. Vielen Dank! Apple verarbeitet es, sobald es genehmigt wurde."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu aporte está pendiente de aprobación. ¡Gracias! Apple lo completará cuando se apruebe."

    "Extra Cushion" : {
      "comment" : "A label for the extra cushion percentage in the category goal auto-configuration settings.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",

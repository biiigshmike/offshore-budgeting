    "Controls Daily Expense, Planned Income, and Preset Expense Due reminders. Excursion Mode is managed separately." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتحكم هذه الإعدادات في تذكيرات النفقات اليومية والدخل المخطط والنفقات المستحقة من الإعدادات المسبقة. تُدار تذكيرات وضع الرحلة بشكل منفصل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Steuert Erinnerungen für tägliche Ausgaben, geplantes Einkommen und fällige Ausgaben aus Voreinstellungen. Der Ausflugsmodus wird separat verwaltet."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla los recordatorios de gastos diarios, ingresos planificados y vencimientos de gastos de plantillas. El Modo excursión se configura por separado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gère les rappels de dépenses quotidiennes, de revenus prévus et d’échéances des dépenses issues de préréglages. Le mode Excursion se règle séparément."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Controla os lembretes de despesas diárias, renda planejada e vencimentos de despesas predefinidas. O Modo Excursão é configurado separadamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "管理每日费用、计划收入和预设费用到期提醒。游览模式需单独设置。"
          }
        }
      }
    },

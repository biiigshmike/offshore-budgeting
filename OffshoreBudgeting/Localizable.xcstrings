      }
    },
    "Your device’s settings control when reminders appear." : {
      "comment" : "Text describing how the user’s device controls when notifications appear.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتحكم إعدادات جهازك في وقت ظهور التذكيرات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einstellungen Ihres Geräts bestimmen, wann Erinnerungen erscheinen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los ajustes de tu dispositivo controlan cuándo aparecen los recordatorios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

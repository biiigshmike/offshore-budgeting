    "Parse a screenshot image and return an import preview summary." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخرج المعاملات من لقطة شاشة ويعرض ملخص معاينة الاستيراد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erkennt Buchungen in einem Screenshot und gibt eine Zusammenfassung der Importvorschau zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrae movimientos de una captura de pantalla y devuelve un resumen de la vista previa de importación."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrait les écritures d’une capture d’écran et renvoie un résumé de l’aperçu de l’importation."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Extrai lançamentos de uma captura de tela e retorna um resumo da prévia de importação."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从截图中提取记录，并返回导入预览摘要。"
          }
        }
      }
    },
    "Parse entry text from clipboard-style input and return an import preview summary." : {
      "localizations" : {
        "ar" : {

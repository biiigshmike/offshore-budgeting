    "Import entries and income (.csv only) directly into a card from its detail view. Select what you want, then attach them instantly." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم باستيراد الإدخالات والدخل (.csv فقط) مباشرة إلى البطاقة من عرض التفاصيل الخاص بها. حدد ما تريد، ثم قم بإرفاقه على الفور."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importieren Sie Einträge und Einnahmen (nur .csv) direkt aus der Detailansicht einer Karte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import entries and income (.csv only) directly into a card from its detail view. Select what you want, then attach them instantly."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa movimientos e ingresos (.csv solamente) directamente a una tarjeta desde su vista de detalle. Selecciona lo que quieras y adjúntalo al instante."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez des entrées et des revenus (.csv uniquement) directement dans une carte depuis sa vue détaillée. Sélectionnez ce que vous voulez, puis attachez-les instantanément."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe entradas e receitas (somente .csv) diretamente em um cartão a partir de sua visualização detalhada. Selecione o que deseja e anexe-os instantaneamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "从详细视图将条目和收入（仅限 .csv）直接导入到卡片中。选择您想要的内容，然后立即附加它们。"
          }
        }
      }
    },

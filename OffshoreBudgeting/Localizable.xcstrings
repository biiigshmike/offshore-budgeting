    "Add a card first. A preset needs a card for its planned expenses." : {
      "comment" : "A description of the error that occurs when a user tries to add a preset without adding a card first.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أضف بطاقة أولًا. يحتاج الإعداد المسبق إلى بطاقة لنفقاته المخططة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Füge zuerst eine Karte hinzu. Eine Voreinstellung benötigt eine Karte für ihre geplanten Ausgaben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade primero una tarjeta. Una plantilla necesita una tarjeta para sus gastos planificados."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajoutez d’abord une carte. Un préréglage a besoin d’une carte pour ses dépenses prévues."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adicione um cartão primeiro. Uma predefinição precisa de um cartão para suas despesas planejadas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los widgets Proyección de ahorros y Gasto seguro hoy ahora están disponibles para la pantalla de inicio y la pantalla bloqueada en iOS, así como para el escritorio en macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les widgets Prévoir l’épargne et Safe Spend Aujourd’hui sont maintenant disponibles sur l’écran d’accueil et l’écran verrouillé d’iOS, ainsi que sur le bureau de macOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {

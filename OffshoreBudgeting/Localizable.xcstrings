        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les informations sur les budgets ont changé. Fermez cet aperçu et consultez-le de nouveau avant de créer les budgets."
          }
        },
        "pt-BR" : {

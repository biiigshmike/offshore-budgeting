    },
    "This estimate does not include variable expenses, payments from savings, or changes you enter directly in Offshore Savings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يشمل هذا التقدير النفقات المتغيرة، أو المدفوعات من الادخار، أو التغييرات التي تدخلها مباشرة في Offshore Savings."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Schätzung enthält keine variablen Ausgaben, Zahlungen aus Ersparnissen oder Änderungen, die Sie direkt in Offshore Savings eingeben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta estimación no incluye gastos variables, pagos desde ahorros ni cambios que introduces directamente en Offshore Savings."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette estimation n’inclut pas les dépenses variables, les paiements depuis l’épargne ni les modifications que vous saisissez directement dans Offshore Savings."
          }
        },
        "pt-BR" : {
          "stringUnit" : {

    "Budget availability changed. Review your selection and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّر توفّر الميزانيات. راجع اختيارك وحاول مرة أخرى."
          }

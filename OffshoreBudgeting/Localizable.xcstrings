    "You can restart onboarding at any time. Your current data source and saved data will stay in place." : {
      "comment" : "A confirmation alert for repeating onboarding.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك اعادة تشغيل الاعداد التعريفي في اي وقت. سيبقى مصدر البيانات الحالي والبيانات المحفوظة كما هي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst das Onboarding jederzeit erneut starten. Deine aktuelle Datenquelle und deine gespeicherten Daten bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes reiniciar el onboarding en cualquier momento. Tu fuente de datos actual y tus datos guardados permaneceran intactos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez relancer l’onboarding a tout moment. Votre source de donnees actuelle et vos donnees enregistrees resteront en place."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

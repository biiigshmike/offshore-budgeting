        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie Erinnerungen für tägliche Ausgaben, geplantes Einkommen und fällige Ausgaben aus Voreinstellungen. Die Einrichtung ist optional."

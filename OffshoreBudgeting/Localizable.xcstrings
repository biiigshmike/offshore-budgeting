        }
      }
    },
    "You can delete the budget now or close this review to keep it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك حذف الميزانية الآن أو إغلاق هذه المراجعة للاحتفاظ بها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können das Budget jetzt löschen oder diese Überprüfung schließen, um es beizubehalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes eliminar el presupuesto ahora o cerrar esta revisión para conservarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez supprimer le budget maintenant ou fermer cet examen pour le conserver."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você pode excluir o orçamento agora ou fechar esta revisão para mantê-lo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以立即删除预算，或关闭此审查以保留预算。"
          }
        }
      }
    },
    "You can restart onboarding at any time. Your current data source and saved data will stay in place." : {
      "comment" : "A confirmation alert for repeating onboarding.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك اعادة تشغيل الاعداد التعريفي في اي وقت. سيبقى مصدر البيانات الحالي والبيانات المحفوظة كما هي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst das Onboarding jederzeit erneut starten. Deine aktuelle Datenquelle und deine gespeicherten Daten bleiben erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes reiniciar el onboarding en cualquier momento. Tu fuente de datos actual y tus datos guardados permaneceran intactos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez relancer l’onboarding a tout moment. Votre source de donnees actuelle et vos donnees enregistrees resteront en place."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voce pode reiniciar o onboarding a qualquer momento. Sua fonte de dados atual e seus dados salvos permanecerao no lugar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可以随时重新开始引导流程。你当前的数据来源和已保存的数据都会保留。"
          }
        }
      }
    },
    "You can return to Workspace Progress in Settings." : {
      "comment" : "A message that appears when the user can return to the Workspace Progress screen.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك العودة إلى تقدم مساحة العمل في الإعدادات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Du kannst in den Einstellungen zum Arbeitsbereichsfortschritt zurückkehren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes volver a Progreso del espacio de trabajo desde Ajustes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez revenir à Progression de l’espace de travail dans Réglages."
          }
        },
        "pt-BR" : {
          "stringUnit" : {

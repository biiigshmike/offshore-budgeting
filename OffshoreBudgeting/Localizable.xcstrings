      }
    },
    "This reminder belongs to %@. Switch there before recording an expense." : {
      "comment" : "A description of the error that occurs when the user tries to record an expense from a workspace that's not the one where the reminder was created.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرتبط هذا التذكير بمساحة العمل %@. انتقل إليها قبل تسجيل نفقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Erinnerung gehört zu %@. Wechseln Sie dorthin, bevor Sie eine Ausgabe erfassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este recordatorio pertenece a %@. Cambia a ese espacio de trabajo antes de registrar un gasto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce rappel est associé à %@. Basculez vers cet espace avant d’enregistrer une dépense."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este lembrete pertence a %@. Mude para esse espaço de trabalho antes de registrar uma despesa."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此提醒属于 %@。请切换到该工作区后再记录支出。"
          }
        }
      }
    },
    "This removes the entry from this workspace." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا إلى إزالة القيد من مساحة العمل هذه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird der Eintrag aus diesem Arbeitsbereich entfernt."
          }

    "There are no transactions or planned expenses for today in this workspace." : {
      "comment" : "A description of the content that is displayed when there are no expenses for the day.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا توجد معاملات أو نفقات مخططة لهذا اليوم في مساحة العمل هذه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Arbeitsbereich gibt es heute keine Transaktionen oder geplanten Ausgaben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hoy no hay transacciones ni gastos planificados en este espacio de trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {

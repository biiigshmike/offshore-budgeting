        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O cartão selecionado para esta importação de atalho não foi encontrado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "找不到为此快捷方式导入选择的卡。"
          }
        }
      }
    },
    "The Spend Trends widget on the Home tab now supports pressing any bar in the graph to reveal expenses from that period." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تدعم ودجة اتجاهات الإنفاق في تبويب الصفحة الرئيسية الآن الضغط على أي شريط في الرسم البياني لعرض المصروفات من تلك الفترة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Widget „Ausgabentrends“ im Home-Tab unterstützt jetzt das Drücken eines beliebigen Balkens im Diagramm, um Ausgaben aus diesem Zeitraum anzuzeigen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The Spend Trends widget on the Home tab now supports pressing any bar in the graph to reveal expenses from that period."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El widget Tendencias de gasto en la pestaña Panel ahora permite presionar cualquier barra del gráfico para revelar los gastos de ese periodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le widget Tendances de dépense de l’onglet d’accueil permet maintenant de toucher n’importe quelle barre du graphique pour afficher les dépenses de cette période."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O widget Tendências de gastos na aba Painel agora permite pressionar qualquer barra no gráfico para revelar as despesas daquele período."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "面板标签页上的支出趋势小组件现在支持按下图表中的任意柱形，以显示该期间的支出。"
          }
        }
      }
    },
    "The split amount increases this reconciliation balance. For debit purchases and planned expenses, it also reduces your share in budget calculations. The full transaction stays in your card history." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيد المبلغ المقسم رصيد التسوية هذا. وبالنسبة لمشتريات الخصم والمصروفات المخططة، يقلل أيضًا حصتك في حسابات الميزانية. وتبقى المعاملة كاملة في سجل البطاقة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der aufgeteilte Betrag erhöht diesen Abstimmungssaldo. Bei Kaufbelastungen und geplanten Ausgaben verringert er außerdem Ihren Anteil in Budgetberechnungen. Die vollständige Buchung bleibt im Kartenverlauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El importe repartido aumenta este saldo de conciliación. En compras de débito y gastos planificados, también reduce tu parte en los cálculos del presupuesto. La transacción completa permanece en el historial."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le montant réparti augmente ce solde de rapprochement. Pour les achats débités et les dépenses prévues, il réduit aussi votre part dans les calculs budgétaires. La transaction entière reste dans l’historique."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O valor dividido aumenta este saldo de reconciliação. Em compras a débito e despesas planejadas, também reduz sua parte nos cálculos do orçamento. A transação completa permanece no histórico."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "分摊金额会增加此调节余额。对于借记消费和计划支出，还会在预算计算中减少你承担的份额。完整交易仍保留在卡片历史中。"
          }
        }
      }
    },
    "The sum of this account’s savings ledger entries across all dates." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مجموع قيود سجل الادخار لهذا الحساب عبر جميع التواريخ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Summe aller Sparbuchungen dieses Kontos über alle Daten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suma de los movimientos del registro de ahorro de esta cuenta en todas las fechas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La somme des écritures du registre d’épargne de ce compte, toutes dates confondues."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A soma dos lançamentos de poupança desta conta em todas as datas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此账户所有日期的储蓄账目记录之和。"
          }
        }
      }
    },
    "The vault is officially ready for its first Offshore account!" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "القبو جاهز رسميًا لأول حساب Offshore!"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Tresor ist offiziell für sein erstes Offshore-Konto bereit!"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The vault is officially ready for its first Offshore account!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El cofre está oficialmente listo para su primera cuenta de Offshore."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le coffre est officiellement prêt pour son premier compte Offshore !"
          }
        },
        "pt-BR" : {
          "stringUnit" : {

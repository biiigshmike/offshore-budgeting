    "Allow Always location access to get nearby reminders when Offshore isn’t open." : {
      "comment" : "A button that opens the system settings to allow location access.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اسمح بالوصول إلى الموقع دائمًا لتلقي تذكيرات بالأماكن القريبة حتى عندما يكون Offshore مغلقًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben Sie den Standortzugriff mit „Immer“, um Erinnerungen zu Orten in der Nähe auch dann zu erhalten, wenn Offshore geschlossen ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona «Siempre» para el acceso a la ubicación y recibe recordatorios de lugares cercanos aunque Offshore esté cerrada."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez « Toujours » pour l’accès à votre position afin de recevoir des rappels de proximité même quand Offshore est fermée."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

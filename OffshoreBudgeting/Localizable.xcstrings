    "Amounts are rounded for your selected currency before expenses are counted as above, below, or on plan." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرّب Offshore المبالغ حسب عملتك المختارة قبل تصنيف النفقات على أنها أعلى من الخطة أو أقل منها أو مطابقة لها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offshore rundet Beträge für Ihre ausgewählte Währung, bevor Ausgaben als über, unter oder im Plan gezählt werden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offshore redondea los importes según la moneda seleccionada antes de contar los gastos que superan lo planificado, quedan por debajo o coinciden."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offshore arrondit les montants selon la devise sélectionnée avant de compter les dépenses supérieures, inférieures ou égales aux prévisions."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offshore arredonda os valores para a moeda selecionada antes de contar as despesas como acima, abaixo ou dentro do planejado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offshore先按所选货币的精度对金额四舍五入，再统计费用是高于、低于还是符合计划。"
          }
        }
      }
    },

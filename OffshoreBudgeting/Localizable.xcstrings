            "value" : "Was ist passiert?\n\nWas haben Sie erwartet?\n\nWelche Schritte führten zum Problem?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Qué ocurrió?\n\n¿Qué esperabas?\n\n¿Qué pasos llevaron al problema?"
          }
        },
        "fr" : {
          "stringUnit" : {

      }
    },
    "Try saving the preset again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أعِد محاولة حفظ الإعداد المسبق."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Versuchen Sie erneut, die Voreinstellung zu speichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intenta guardar la plantilla de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réessayez d’enregistrer le préréglage."
          }
        },
        "pt-BR" : {

        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eine tägliche Erinnerung, Ihre Ausgaben zu erfassen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un recordatorio diario para que registres tus gastos."
          }
        },
        "fr" : {
          "stringUnit" : {

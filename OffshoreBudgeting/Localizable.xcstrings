    "homeWidget.spendTrends.bucketHideHint" : {
      "comment" : "Accessibility hint for hiding selected spend trends bucket expenses.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط مرتين لإخفاء المصروفات في هذه الفترة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

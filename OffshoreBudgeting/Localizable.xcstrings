    "Add expenses directly in Card Detail to keep the selected card ledger current." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بإضافة النفقات مباشرة في تفاصيل البطاقة للحفاظ على تحديث دفتر أستاذ البطاقة المحدد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",

            "value" : "Du hast alle Kernfunktionen eingerichtet. Jetzt kannst du mit Offshore deine Budgets planen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has configurado todas las funciones básicas. Ya puedes empezar a gestionar tu presupuesto con Offshore."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous avez configuré toutes les fonctions essentielles. Vous pouvez commencer à gérer votre budget avec Offshore."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

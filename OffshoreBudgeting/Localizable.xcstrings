    },
    "A daily nudge to log your expenses." : {
      "comment" : "A description of the daily expense reminder.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تذكير يومي بسيط لتسجيل نفقاتك."

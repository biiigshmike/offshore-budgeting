    "Improved Reconciliations and Savings" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحسينات على التسويات والادخار"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verbesserungen bei Abstimmungen und Ersparnissen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Improved Reconciliations and Savings"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejoras en las conciliaciones y el ahorro"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ameliorations des rapprochements et de l’epargne"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melhorias nas reconciliacoes e na poupanca"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "对对账和储蓄的改进"
          }
        }
      }
    },
    "Improved workspace setup, refined expense actions and preset schedules, clarified Home calculations, and polished widgets and the Mac Home editor." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حسّنا إعداد مساحات العمل، وطوّرنا إجراءات النفقات وجداول الإعدادات المسبقة، ووضّحنا حسابات الشاشة الرئيسية، وحسّنا الأدوات ومحرّر الشاشة الرئيسية على Mac."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Einrichtung von Arbeitsbereichen wurde verbessert, Aktionen für Ausgaben und Zeitpläne für Voreinstellungen wurden überarbeitet, Berechnungen auf der Startseite wurden verständlicher gestaltet und Widgets sowie der Startseiteneditor auf dem Mac wurden verfeinert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mejoramos la configuración de los espacios de trabajo, ajustamos las acciones de gastos y la programación de las plantillas, aclaramos los cálculos del Panel y retocamos los widgets y el editor del Panel en el Mac."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La configuration des espaces de travail, les actions sur les dépenses et la planification des préréglages ont été améliorées. Les calculs sur l’accueil ont été clarifiés et les widgets, ainsi que l’éditeur de l’accueil sur Mac, ont été peaufinés."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Melhoramos a configuração dos espaços de trabalho, aprimoramos as ações de despesas e as recorrências de predefinições, esclarecemos os cálculos da tela Lar e refinamos os widgets e o editor da tela Lar no Mac."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "改进了工作区设置、支出操作和预设日程，明确了首页计算规则，并优化了小组件和 Mac 上的首页编辑器。"
          }
        }
      }
    },
    "Improvements to Importing Expenses" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحسينات على استيراد النفقات"
          }
        },
        "de" : {

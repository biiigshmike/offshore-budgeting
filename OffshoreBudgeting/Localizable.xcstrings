    "categories.tip.rowActions" : {
      "comment" : "Categories tip explaining tap navigation and row actions.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على فئة لاستعراض المصروفات عبر البطاقات والتواريخ. اضغط مطولًا على الصف لعرض جميع الإجراءات، أو اسحب لإظهارها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tippe auf eine Kategorie, um Ausgaben über Karten und Zeiträume hinweg zu durchsuchen. Halte eine Zeile gedrückt, um alle Aktionen zu sehen, oder wische, um sie einzublenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tap a category to explore expenses across cards and dates. Press and hold a row for all actions, or swipe to reveal them."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca una categoría para explorar los gastos de distintas tarjetas y fechas. Mantén pulsada una fila para ver todas las acciones o desliza para mostrarlas."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une catégorie pour consulter ses dépenses par carte et par date. Maintenez une ligne enfoncée ou balayez-la pour afficher ses actions."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em uma categoria para explorar despesas de vários cartões e datas. Mantenha uma linha pressionada para ver todas as ações ou deslize para exibi-las."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "轻点类别可查看不同卡片和日期的支出。长按一行可查看所有操作，也可以轻扫来显示操作。"
          }
        }
      }
    },

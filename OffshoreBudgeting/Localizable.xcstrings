    "Forecast Savings and Safe Spend Today widgets are now available for the Home Screen and Lock Screen on iOS, as well as the desktop on macOS." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أصبحت ودجتا توقعات الادخار والإنفاق الآمن اليوم متاحتين الآن لشاشة الرئيسية وشاشة القفل على iOS، وكذلك لسطح المكتب على macOS."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Widgets „Einsparungen prognostizieren“ und „Sichere Ausgaben heute“ sind jetzt für den Home-Bildschirm und Sperrbildschirm auf iOS sowie für den Schreibtisch auf macOS verfügbar."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Forecast Savings and Safe Spend Today widgets are now available for the Home Screen and Lock Screen on iOS, as well as the desktop on macOS."

    "Leave Category unchanged if you want these expenses added as Uncategorized. Turn off Show When Run, then tap Save." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اترك الفئة دون تغيير إذا كنت تريد إضافة هذه المصروفات كغير مصنفة. أوقف إظهار عند التشغيل، ثم اضغط حفظ."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lasse Kategorie unverändert, wenn diese Ausgaben als Nicht kategorisiert hinzugefügt werden sollen. Deaktiviere Beim Ausführen anzeigen und tippe dann auf Sichern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deja Categoría sin cambios si quieres que estos gastos se agreguen como Sin categoría. Desactiva Mostrar al ejecutar y luego toca Guardar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Laissez Catégorie inchangé si vous voulez que ces dépenses soient ajoutées comme Non classées. Désactivez Afficher à l’exécution, puis touchez Enregistrer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deixe Categoria inalterada se quiser que essas despesas sejam adicionadas como Sem categoria. Desative Mostrar ao Executar e toque em Salvar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果你希望这些支出作为“未分类”添加，请保持“类别”不变。关闭“运行时显示”，然后点按“保存”。"
          }
        }
      }
    },

    "Expense totals follow the current search and category filters. Income and savings adjustments use the full budget date range." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتبع إجماليات المصروفات عوامل تصفية البحث والفئات الحالية. ويستخدم الدخل وتعديلات الادخار النطاق الكامل لتواريخ الميزانية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgabensummen folgen den aktuellen Such- und Kategoriefiltern. Einnahmen und Sparanpassungen verwenden den gesamten Budgetzeitraum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los gastos respetan los filtros actuales de búsqueda y categoría. Los ingresos y ajustes de ahorro usan todo el intervalo del presupuesto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les dépenses suivent les filtres de recherche et de catégorie actuels. Les revenus et ajustements d’épargne utilisent toute la période du budget."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os totais de despesas seguem os filtros atuais de busca e categoria. A renda e os ajustes de poupança usam todo o intervalo do orçamento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支出总额遵循当前搜索和类别筛选。收入及手动储蓄调整使用完整预算日期范围。"
          }
        }
      }
    },

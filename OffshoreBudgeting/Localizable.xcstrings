    },
    "These totals use the expenses included by this screen’s calculation settings. Hiding an expense does not by itself exclude it from totals." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تستخدم هذه الإجماليات المصروفات المشمولة بإعدادات الحساب في هذه الشاشة. ولا يؤدي إخفاء مصروف وحده إلى استبعاده من الإجماليات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Summen verwenden die gemäß den Berechnungseinstellungen dieses Bildschirms einbezogenen Ausgaben. Das Ausblenden allein schließt eine Ausgabe nicht aus Summen aus."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos totales usan los gastos incluidos por los ajustes de cálculo de esta pantalla. Ocultar un gasto no lo excluye por sí solo de los totales."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces totaux utilisent les dépenses incluses par les réglages de calcul de cet écran. Masquer une dépense ne l’exclut pas à lui seul des totaux."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes totais usam as despesas incluídas pelos ajustes de cálculo desta tela. Ocultar uma despesa, por si só, não a exclui dos totais."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些总额使用本屏幕计算设置所包含的支出。仅隐藏支出并不会将其从总额中排除。"
          }
        }
      }
    },
    "They Owe Me" : {

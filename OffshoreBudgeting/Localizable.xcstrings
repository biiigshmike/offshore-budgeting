    "Parse a screenshot image and return an import preview summary." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحليل صورة لقطة الشاشة وإرجاع ملخص معاينة الاستيراد."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analysieren Sie ein Screenshot-Bild und geben Sie eine Zusammenfassung der Importvorschau zurück."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Analiza una captura de pantalla y devuelve un resumen de vista previa de importación."
          }
        },
        "fr" : {

    "Import CSV/PDF/image records, use mapping memory for repeats, and avoid payment-transfer expense rows." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم باستيراد سجلات CSV/PDF/الصور، واستخدم ذاكرة التعيين للتكرارات، وتجنب صفوف نفقات تحويل الدفع."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importieren Sie CSV-/PDF-/Bilddatensätze, nutzen Sie den Zuordnungsspeicher für Wiederholungen und vermeiden Sie Ausgabenzeilen für Zahlungsübertragungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Import CSV/PDF/image records, use mapping memory for repeats, and avoid payment-transfer expense rows."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importa registros CSV/PDF/imagen, usa memoria de mapeo para repeticiones y evita filas de gasto de transferencias de pago."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importez des enregistrements CSV/PDF/image, utilisez la mémoire de correspondance pour les répétitions et évitez les lignes de dépense liées aux transferts de paiement."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Importe registros CSV/PDF/imagem, use memória de mapeamento para repetições e evite linhas de despesas de transferência de pagamento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "导入 CSV/PDF/图像记录，使用映射内存进行重复，并避免支付转账费用行。"
          }
        }
      }
    },

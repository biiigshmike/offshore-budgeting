    "Full-budget estimate if you use your remaining category allowances. Spending already above a maximum is included." : {
      "comment" : "Category goal savings scenario and guidance.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقدير للميزانية كاملة إذا استخدمت المبالغ المتبقية المتاحة للفئات. يشمل الإنفاق الذي تجاوز بالفعل أي حد أقصى."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Schätzung für das gesamte Budget, wenn Sie die verbleibenden Kategorie-Spielräume ausschöpfen. Bereits über einem Höchstwert liegende Ausgaben sind enthalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Full-budget estimate if you use your remaining category allowances. Spending already above a maximum is included."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimación del presupuesto completo si usas los importes disponibles restantes por categoría. Incluye el gasto que ya supera un máximo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimation pour tout le budget si vous utilisez les montants encore disponibles par catégorie. Les dépenses dépassant déjà un maximum sont incluses."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estimativa do orçamento completo se você usar os valores restantes disponíveis por categoria. Inclui gastos que já ultrapassam um máximo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "假设您用完各类别的剩余额度，对整个预算进行估算。已超出上限的支出也会计入。"

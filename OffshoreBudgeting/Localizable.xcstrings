    "Current Expense Impact" : {
      "comment" : "Category goal savings scenario and guidance.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أثر المصروفات الحالي"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aktuelle Ausgabenbelastung"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Current Expense Impact"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impacto actual de los gastos"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impact actuel des dépenses"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impacto atual das despesas"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前支出影响"
          }
        }
      }
    },
    "Current expense impact includes recorded planned amounts when available, otherwise planned amounts, plus variable expenses. Shared splits, payments from savings, and refunds follow the usual budget-impact rules." : {
      "comment" : "Category goal savings scenario and guidance.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشمل أثر المصروفات الحالي المبالغ الفعلية المسجلة للمصروفات المخططة عند توفرها، وإلا فالمبالغ المخططة، إضافة إلى المصروفات المتغيرة. تتبع التقسيمات المشتركة والمدفوعات من المدخرات والمبالغ المستردة قواعد الأثر المعتادة على الميزانية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die aktuelle Ausgabenbelastung umfasst erfasste Istbeträge geplanter Ausgaben, sofern vorhanden, sonst Planbeträge, sowie variable Ausgaben. Geteilte Beträge, Zahlungen aus Ersparnissen und Erstattungen folgen den üblichen Regeln zur Budgetbelastung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Current expense impact includes recorded planned amounts when available, otherwise planned amounts, plus variable expenses. Shared splits, payments from savings, and refunds follow the usual budget-impact rules."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El impacto actual de los gastos incluye los importes reales registrados de los gastos planificados cuando existen; en caso contrario, los importes planificados, más los gastos variables. Los repartos, los pagos desde ahorros y los reembolsos siguen las reglas habituales de impacto en el presupuesto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’impact actuel des dépenses comprend les montants réels enregistrés des dépenses planifiées lorsqu’ils existent, sinon les montants prévus, ainsi que les dépenses variables. Les partages, les paiements depuis l’épargne et les remboursements suivent les règles habituelles d’impact sur le budget."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O impacto atual das despesas inclui os valores reais registrados das despesas planejadas, quando disponíveis; caso contrário, os valores planejados, mais as despesas variáveis. Divisões, pagamentos com economias e reembolsos seguem as regras habituais de impacto no orçamento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当前支出影响包括计划支出已记录的实际金额（如有），否则使用计划金额，另加可变支出。分摊、从储蓄付款和退款遵循通常的预算影响规则。"
          }
        }
      }
    },

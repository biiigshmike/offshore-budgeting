    "iCloud Sync Options" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "خيارات مزامنة iCloud"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iCloud-Sync-Optionen"
          }
        },
        "en" : {
          "stringUnit" : {

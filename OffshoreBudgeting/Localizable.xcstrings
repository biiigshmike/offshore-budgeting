    "This deletes the Reconciliation permanently." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يؤدي هذا إلى حذف المصالحة بشكل دائم."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch wird die Abstimmung dauerhaft gelöscht."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto elimina la conciliación de forma permanente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This deletes the Rapprochement permanently."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isso exclui a Reconciliação permanentemente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

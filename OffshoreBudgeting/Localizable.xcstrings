          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beobachten Sie die Trendrichtung und nicht nur die Gesamtzahlen, um die Beschleunigung frühzeitig zu erkennen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Watch trend direction, not just totals, to catch acceleration early."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Observa la dirección de la tendencia, no solo los totales, para detectar la aceleración temprano."

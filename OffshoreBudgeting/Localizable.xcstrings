    "You can change these choices anytime in Settings." : {
      "comment" : "A footer for the reminder setup form, explaining that the user can change their choices anytime in Settings.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {

    "Budget information changed. Close this preview and review it again before creating budgets." : {
      "comment" : "Error message displayed when the user tries to create budgets while the budget preview is open.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {

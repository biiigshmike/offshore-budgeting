    "To hide this row, go to Settings > General > Maintenance and turn on Hide Workspace Progress." : {
      "comment" : "A description of how to hide the Workspace Progress section.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لإخفاء هذا الصف، انتقل إلى الإعدادات > عام > الصيانة وفعّل «إخفاء تقدم مساحة العمل»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um diese Zeile auszublenden, gehe zu Einstellungen > Allgemein > Wartung und aktiviere „Arbeitsbereichsfortschritt ausblenden“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ocultar esta fila, ve a Ajustes > General > Mantenimiento y activa Ocultar progreso del espacio de trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour masquer cette ligne, allez dans Réglages > Général > Maintenance et activez Masquer la progression de l’espace de travail."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para ocultar esta linha, acesse Configurações > Em geral > Manutenção e ative Ocultar progresso do espaço de trabalho."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "若要隐藏此行，请前往“设置 > 通用 > 维护”，并开启“隐藏工作区进度”。"
          }
        }
      }
    },
    "To manage Offshore’s iCloud storage, open the iOS Settings app and go to:\nApple ID → iCloud → Storage → Offshore Budgeting" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لإدارة مساحة تخزين iCloud الخاصة بـ Offshore، افتح تطبيق إعدادات iOS وانتقل إلى:\nمعرف Apple → iCloud → التخزين → ميزانية Offshore"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Um den iCloud-Speicher von Offshore zu verwalten, öffnen Sie die iOS-Einstellungen-App und gehen Sie zu:\nApple-ID → iCloud → Speicher → Offshore Budgetierung"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para administrar el almacenamiento de iCloud de Offshore, abre la app Ajustes de iOS y ve a:\nApple ID → iCloud → Almacenamiento → Offshore Budgeting"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "To manage Offshore’s iCloud storage, open the iOS Réglages app and go to:\nApple ID → iCloud → Storage → Offshore Budgeting"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para gerenciar o armazenamento iCloud do Offshore, abra o aplicativo Configurações do iOS e vá para:\nApple ID → iCloud → Armazenamento → Orçamento Offshore"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要管理 Offshore 的 iCloud 存储，请打开 iOS 设置应用程序并转至：\nApple ID → iCloud → 存储 → Offshore 预算"
          }
        }
      }
    },
    "To receive reminders, allow notifications in your device’s Settings." : {
      "comment" : "A description of the error that occurs when the user has denied notifications.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لتلقي التذكيرات، اسمح بالإشعارات في إعدادات جهازك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erlauben Sie Benachrichtigungen in den Einstellungen Ihres Geräts, um Erinnerungen zu erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

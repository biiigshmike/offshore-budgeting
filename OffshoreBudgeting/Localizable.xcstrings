    },
    "Choose a CSV, PDF, or image from Files or Photos to begin. Expense rows will be skipped." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ملف CSV أو PDF أو صورة من «الملفات» أو «الصور» للبدء. سيتم تخطي صفوف النفقات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie aus „Dateien“ oder „Fotos“ eine CSV-Datei, eine PDF-Datei oder ein Bild aus. Zeilen mit Ausgaben werden übersprungen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona un archivo CSV, PDF o una imagen de Archivos o Fotos para empezar. Se omitirán las filas de gastos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pour commencer, choisissez un fichier CSV, un PDF ou une image dans Fichiers ou Photos. Les lignes de dépenses seront ignorées."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para começar, escolha um arquivo CSV, PDF ou uma imagem em Arquivos ou Fotos. As linhas de despesas serão ignoradas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请从“文件”或“照片”中选择 CSV、PDF 或图片以开始导入。费用行将被跳过。"
          }
        }
      }

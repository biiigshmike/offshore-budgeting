    "Helps Excursion Mode continue monitoring reliably when Offshore is not in the foreground." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يساعد وضع Excursion على مواصلة المراقبة بشكل موثوق عندما لا يكون Offshore في المقدمة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hilft dem Exkursionsmodus, die Überwachung zuverlässig fortzusetzen, wenn Offshore nicht im Vordergrund steht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Helps Excursion Mode continue monitoring reliably when Offshore is not in the foreground."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayuda a que el modo Excursion siga supervisando de forma confiable cuando Offshore no esta en primer plano."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aide le mode Excursion a continuer la surveillance de maniere fiable lorsque Offshore n'est pas au premier plan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ajuda o Modo Excursão a continuar monitorando de forma confiável quando o Offshore não está em primeiro plano."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 Offshore 不在前台时，帮助偏移模式继续可靠地进行监控。"
          }
        }
      }
    },
    "Hide Future Planned Expenses" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إخفاء النفقات المخططة المستقبلية"
          }
        },
        "de" : {

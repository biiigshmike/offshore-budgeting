          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar iCloud"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser iCloud"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar iCloud"
          }
        },
        "zh-Hans" : {

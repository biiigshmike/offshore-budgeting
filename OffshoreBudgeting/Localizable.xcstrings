            "value" : "تغيّرت معلومات الميزانيات. أغلق هذه المعاينة وراجعها مرة أخرى قبل إنشاء الميزانيات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Budgetdaten haben sich geändert. Schließen Sie diese Vorschau und prüfen Sie sie erneut, bevor Sie Budgets erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cambió la información de los presupuestos. Cierra esta vista previa y vuelve a revisarla antes de crearlos."

    "Some planned expenses created by this budget have recorded spending. Review them below if you want to delete any." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سُجّل مبلغ فعلي لبعض النفقات المخططة التي أنشأتها هذه الميزانية. راجعها أدناه إذا أردت حذف أيٍّ منها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für einige geplante Ausgaben, die dieses Budget erstellt hat, wurde bereits ein tatsächlicher Betrag erfasst. Prüfen Sie die Ausgaben unten, wenn Sie einzelne davon löschen möchten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos gastos planificados que este presupuesto generó ya tienen un importe real registrado. Revisa la lista de abajo si quieres eliminar alguno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un montant réel a été saisi pour certaines dépenses prévues que ce budget a créées. Consultez les dépenses ci-dessous si vous souhaitez en supprimer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algumas despesas planejadas que este orçamento gerou já têm um valor real registrado. Confira a lista abaixo se quiser excluir alguma."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此预算生成的部分计划支出已记录实际金额。如需删除其中任何一笔，请在下方查看。"
          }
        }
      }
    },
    "Some planned expenses created by this budget on %@ have recorded spending. Review them below if you want to delete any." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سُجّل مبلغ فعلي لبعض النفقات المخططة التي أنشأتها هذه الميزانية على بطاقة «%@». راجعها أدناه إذا أردت حذف أيٍّ منها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für einige geplante Ausgaben, die dieses Budget auf der Karte %@ erstellt hat, wurde bereits ein tatsächlicher Betrag erfasst. Prüfen Sie die Ausgaben unten, wenn Sie einzelne davon löschen möchten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos gastos planificados que este presupuesto generó para la tarjeta %@ ya tienen un importe real registrado. Revisa la lista de abajo si quieres eliminar alguno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un montant réel a été saisi pour certaines dépenses prévues que ce budget a créées sur la carte %@. Consultez les dépenses ci-dessous si vous souhaitez en supprimer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algumas despesas planejadas que este orçamento gerou para o cartão %@ já têm um valor real registrado. Confira a lista abaixo se quiser excluir alguma."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此预算在“%@”卡片上生成的部分计划支出已记录实际金额。如需删除其中任何一笔，请在下方查看。"
          }
        }
      }
    },

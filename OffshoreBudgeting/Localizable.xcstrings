    "Goals apply only to this budget. Leave either amount blank if you don't want that goal." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تنطبق الأهداف على هذه الميزانية فقط. اترك أي مبلغ فارغًا إذا لم ترغب في ذلك الهدف."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziele gelten nur für dieses Budget. Lassen Sie einen Betrag leer, wenn Sie dieses Ziel nicht möchten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los objetivos solo se aplican a este presupuesto. Deja un importe en blanco si no quieres fijar ese objetivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les objectifs s’appliquent uniquement à ce budget. Laissez un montant vide si vous ne souhaitez pas cet objectif."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As metas valem apenas para este orçamento. Deixe um valor em branco se não quiser essa meta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标仅适用于本预算。如果不需要某项目标，可将对应金额留空。"
          }
        }
      }
    },
    "Goals During Budget Creation" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {

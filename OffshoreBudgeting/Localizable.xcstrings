    "Start a focused excursion mode session for a fixed time." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ابدأ جلسة محددة المدة في وضع الرحلة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Startet den Ausflugsmodus für eine festgelegte Dauer."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inicia una sesión del modo excursión durante un tiempo determinado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Démarre une session du mode Excursion pour une durée déterminée."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

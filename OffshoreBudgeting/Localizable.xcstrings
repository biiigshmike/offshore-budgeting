    "Highest: %@, %@. This period has the highest chart total above zero. If periods tie, the earliest one is shown." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأعلى: %@، %@. لهذه الفترة أعلى إجمالي أكبر من صفر في الرسم البياني. إذا تساوت الفترات، يعرض Offshore أقدمها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Höchster Wert: %@, %@. Dieser Zeitraum hat den höchsten Diagrammwert über null. Bei Gleichstand zeigt Offshore den frühesten Zeitraum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más alto: %@, %@. Este periodo tiene el mayor total del gráfico por encima de cero. Si hay empate, Offshore muestra el periodo más antiguo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plus élevé : %@, %@. Cette période a le total du graphique le plus élevé au-dessus de zéro. En cas d’égalité, Offshore affiche la période la plus ancienne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mais alto: %@, %@. Este período tem o maior total do gráfico acima de zero. Em caso de empate, Offshore mostra o período mais antigo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最高：%@，%@。此期间的图表总额是所有大于零的总额中最高的。如有并列，则显示最早的期间。"
          }
        }
      }
    },

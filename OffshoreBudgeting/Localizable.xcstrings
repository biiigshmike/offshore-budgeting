    "On Device" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "على الجهاز"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Auf dem Gerät"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En este dispositivo"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sur l’appareil"
          }
        },
        "pt-BR" : {

    "Auto-Configure Goals" : {
      "comment" : "The title of a screen that lets the user configure the auto-configuration of category goals.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إعداد الأهداف تلقائيًا"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziele automatisch konfigurieren"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurar objetivos automáticamente"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurer les objectifs automatiquement"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Configurar metas automaticamente"
          }
        },
        "zh-Hans" : {

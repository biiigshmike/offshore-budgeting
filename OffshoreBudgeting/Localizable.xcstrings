            "value" : "Füge eine Karte hinzu, um deine Ausgaben zu verfolgen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Añade una tarjeta para llevar el control de tus gastos."
          }
        },
        "fr" : {

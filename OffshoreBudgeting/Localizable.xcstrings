    "Variance" : {
      "comment" : "Preset detail and preset row presentation.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variance"
          }
        }
      }
    },
    "Variance is effective amount minus the occurrence’s stored planned amount, not the preset’s current amount. Averages and period comparisons include recorded and assumed occurrences. Averages are per occurrence, not per chart period. Future visibility and calculation settings apply independently." : {
      "comment" : "Preset detail calculation help.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Variance is effective amount minus the occurrence’s stored planned amount, not the preset’s current amount. Averages and period comparisons include recorded and assumed occurrences. Averages are per occurrence, not per chart period. Future visibility and calculation settings apply independently."
          }
        }
      }
    },

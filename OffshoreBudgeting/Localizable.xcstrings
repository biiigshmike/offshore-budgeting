    },
    "A Farewell to Marina, For Now" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وداعًا يا Marina، إلى حين"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein Abschied von Marina, vorerst"

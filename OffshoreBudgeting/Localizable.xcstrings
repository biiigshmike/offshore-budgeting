    },
    "homeWidget.spendTrends.bucketInstruction" : {
      "comment" : "Instruction text explaining that spend trends chart bars are actionable.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على شريط لعرض المصروفات في فئة الإنفاق تلك. اضغط عليه مرة أخرى لإخفاء التفاصيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Drücken Sie einen Balken, um die Ausgaben in diesem Ausgabenabschnitt anzuzeigen. Drücken Sie ihn erneut, um die Aufschlüsselung auszublenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Press a bar to view the expenses in that spending bucket. Press it again to hide the breakdown."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Presiona una barra para ver los gastos de ese periodo de gasto. Presiónala de nuevo para ocultar el desglose."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez une barre pour afficher les dépenses de cette période de dépense. Touchez-la à nouveau pour masquer le détail."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pressione uma barra para ver as despesas desse período de gastos. Pressione novamente para ocultar o detalhamento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按下柱形可查看该支出区段中的支出。再次按下可隐藏明细。"
          }
        }
      }
    },

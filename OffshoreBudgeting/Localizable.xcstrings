    },
    "There is no Highest or Top label when every period’s chart total is zero." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تظهر تسمية «الأعلى» أو «الأكبر» عندما يكون إجمالي كل فترة في الرسم البياني صفرًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es gibt keine Kennzeichnung „Höchster Wert“ oder „Oben“, wenn der Diagrammwert jedes Zeitraums null ist."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No aparecen las etiquetas Más alto ni Principal cuando el total del gráfico de cada periodo es cero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les libellés Plus élevé et Top n’apparaissent pas lorsque le total du graphique de chaque période est égal à zéro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Não há rótulo “Mais alto” ou “Superior” quando o total do gráfico de todos os períodos é zero."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当所有期间的图表总额都为零时，不显示“最高”或“最多”标签。"
          }
        }
      }
    },
    "These dates overlap existing budgets. Review the ranges before creating." : {
      "comment" : "A description of the error that occurs when the user tries to create budgets that overlap with existing budgets.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتداخل هذه التواريخ مع ميزانيات حالية. راجع النطاقات الزمنية قبل الإنشاء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Zeiträume überschneiden sich mit vorhandenen Budgets. Prüfen Sie die Zeiträume vor dem Erstellen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas fechas se superponen con las de presupuestos existentes. Revisa los intervalos antes de crearlos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces dates chevauchent des budgets existants. Vérifiez les périodes avant de créer les budgets."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essas datas se sobrepõem às de orçamentos existentes. Confira os períodos antes de criá-los."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些日期与现有预算重叠。请在创建前检查日期范围。"
          }
        }
      }
    },
    "These expenses have recorded spending. Review them if you want to delete any." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "وقد سجلت هذه النفقات الإنفاق. قم بمراجعتها إذا كنت تريد حذف أي منها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Ausgaben wurden als Ausgaben erfasst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos gastos tienen gasto registrado. Revísalos si quieres eliminar alguno."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These expenses have recorded spending. Revoir them if you want to delete any."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essas despesas registraram gastos. Revise-os se quiser excluir algum."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些费用都有记录支出。如果您想删除任何内容，请查看它们。"
          }
        }
      }
    },
    "These places were nearby. Choose a place only if you made a purchase." : {
      "comment" : "A description of the list of places that the user can choose from.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كانت هذه الأماكن قريبة منك. اختر مكانًا فقط إذا أجريت عملية شراء فيه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Orte waren in Ihrer Nähe. Wählen Sie nur dann einen Ort aus, wenn Sie etwas gekauft haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos lugares estaban cerca. Elige uno solo si hiciste una compra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces lieux se trouvaient à proximité. Choisissez un lieu seulement si vous y avez fait un achat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estes lugares estavam por perto. Escolha um apenas se fez uma compra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些是附近的地点。请只在确实有消费时选择地点。"
          }
        }
      }
    },
    "These planned expenses have actual spending recorded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه النفقات المخططة لها إنفاق فعلي مسجل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für diese geplanten Ausgaben werden die tatsächlichen Ausgaben erfasst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos gastos planificados tienen gasto real registrado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces dépenses prévues ont des dépenses réelles enregistrées."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essas despesas planejadas têm gastos reais registrados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些计划开支都有实际支出记录。"
          }
        }
      }
    },
    "These totals include this workspace’s income and expenses for these dates. Budgets are here to help you check the details." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تشمل هذه الإجماليات الدخل والنفقات في مساحة العمل هذه خلال التواريخ المحددة. تساعدك الميزانيات في مراجعة التفاصيل."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Summen enthalten die Einnahmen und Ausgaben dieses Arbeitsbereichs an den angegebenen Tagen. Die Budgets helfen dir, die Einzelheiten zu prüfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "These totals include this workspace’s income and expenses for these dates. Budgets are here to help you check the details."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos totales incluyen los ingresos y los gastos de este espacio de trabajo en esas fechas. Los presupuestos te ayudan a revisar los detalles."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces totaux comprennent les revenus et les dépenses de cet espace de travail pour les dates indiquées. Les budgets vous aident à vérifier le détail."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esses totais incluem as receitas e as despesas deste espaço de trabalho nas datas indicadas. Os orçamentos ajudam a conferir os detalhes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些总额包括此工作区在这些日期内的收入和费用。可以通过预算查看明细。"
          }
        }
      }
    },
    "They Owe Me" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إنهم مدينون لي"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie schulden mir etwas"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me deben"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ils me doivent"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eles me devem"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "他们欠我的"
          }
        }
      }
    },
    "They Owe Me adds to the balance. I Owe Them subtracts from it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يزيد «إنهم مدينون لي» الرصيد. ويقلّله «أنا مدين لهم»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Sie schulden mir etwas“ erhöht den Saldo. „Ich schulde ihnen etwas“ senkt ihn."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Me deben suma el monto al saldo. Les debo lo resta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Ils me doivent » ajoute au solde. « Je leur dois » en soustrait."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eles me devem soma o valor ao saldo. Eu devo a eles subtrai o valor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“他们欠我的”会增加余额。“我欠他们”会减少余额。"
          }
        }
      }
    },
    "This and Future" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا والمستقبل"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dies und Zukunft"

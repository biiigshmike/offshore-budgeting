        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: %2$@. La suma de las categorías que se muestran abajo coincide con el total del gráfico para este período."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ : %2$@. La somme des catégories ci-dessous correspond au total du graphique pour cette période."

        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue cada paso en orden y luego compáralo con la captura de pantalla correspondiente en esta guía."
          }
        },
        "fr" : {
          "stringUnit" : {

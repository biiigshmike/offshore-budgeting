            "value" : "请先添加一张卡片。预设需要一张卡片来记录其计划费用。"
          }
        }
      }
    },
    "Add a card to track your spending." : {
      "comment" : "Explanation for the WorkspaceProgressStep.card case.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",

    "Nothing is saved yet. Offshore saves only after you confirm Import." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لم يُحفظ أي شيء بعد. يحفظ Offshore المعاملات بعد تأكيد «استيراد» فقط."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es wurde noch nichts gespeichert. Offshore speichert die Buchungen erst, nachdem Sie „Importieren“ bestätigt haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aún no se ha guardado nada. Offshore guarda los movimientos cuando confirmas «Importar»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aucune écriture n’a été enregistrée. Offshore enregistre les écritures après confirmation de l’option « Importer »."
          }
        },
        "pt-BR" : {

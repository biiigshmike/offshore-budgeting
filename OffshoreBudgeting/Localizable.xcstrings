    "Goals from %@. Availability uses Home’s selected dates. See Savings at Goal Maximums in Budget Detail for a full-budget estimate." : {
      "comment" : "Category goal savings scenario and guidance.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأهداف من %@. يُحسب المتاح باستخدام التواريخ المحددة في الرئيسية. راجع «المدخرات عند الحدود القصوى للأهداف» في تفاصيل الميزانية للحصول على تقدير للميزانية كاملة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ziele aus %@. Die Verfügbarkeit verwendet die auf der Startseite gewählten Daten. Eine Schätzung für das gesamte Budget finden Sie unter „Ersparnisse bei Zielhöchstwerten“ in den Budgetdetails."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Goals from %@. Availability uses Home’s selected dates. See Savings at Goal Maximums in Budget Detail for a full-budget estimate."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objetivos de %@. La disponibilidad usa las fechas seleccionadas en Inicio. Consulta Ahorro con los máximos de los objetivos en Detalle del presupuesto para ver una estimación del presupuesto completo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Objectifs de %@. La disponibilité utilise les dates sélectionnées dans Accueil. Consultez Épargne aux maximums des objectifs dans les détails du budget pour une estimation du budget complet."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metas de %@. A disponibilidade usa as datas selecionadas no Início. Veja Economia nos máximos das metas nos detalhes do orçamento para uma estimativa do orçamento completo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "目标来自%@。可用额度使用首页所选日期。请在预算详情中查看“达到目标上限时的节省”，获取整个预算的估算。"
          }
        }
      }
    },

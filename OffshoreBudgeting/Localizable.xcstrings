    "Credits and adjustments stay in card history and do not contribute to this gross spending total." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تبقى المبالغ الدائنة والتعديلات في سجل البطاقة ولا تُحتسب ضمن إجمالي الإنفاق قبل الخصومات هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gutschriften und Anpassungen bleiben im Kartenverlauf und zählen nicht zu dieser Bruttoausgabensumme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los créditos y ajustes permanecen en el historial de la tarjeta y no se incluyen en este total de gasto bruto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les crédits et ajustements restent dans l’historique de la carte et ne contribuent pas à ce total de dépenses brutes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Créditos e ajustes permanecem no histórico do cartão e não entram neste total de gastos brutos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "贷记和调整保留在卡片历史中，不计入此支出原始总额。"
          }
        }
      }
    },

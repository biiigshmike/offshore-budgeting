      }
    },
    "Offshore Action" : {
      "comment" : "Display name for the type of OffshoreControlDestination.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",

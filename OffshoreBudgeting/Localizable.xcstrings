    "Total Spent shows planned expenses and debit purchases for the selected view. Credits and adjustments remain in card history and do not contribute to this gross spending total." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض إجمالي الإنفاق المصروفات المخططة ومشتريات الخصم للعرض المحدد. تبقى المبالغ الدائنة والتعديلات في سجل البطاقة ولا تُحتسب ضمن إجمالي الإنفاق قبل الخصومات هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesamtausgaben zeigt geplante Ausgaben und Kaufbelastungen der gewählten Ansicht. Gutschriften und Anpassungen bleiben im Kartenverlauf und zählen nicht zu dieser Bruttoausgabensumme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El total gastado muestra gastos planificados y compras de débito para la vista seleccionada. Los créditos y ajustes permanecen en el historial y no contribuyen a este gasto bruto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le total dépensé affiche les dépenses prévues et achats débités de la vue sélectionnée. Les crédits et ajustements restent dans l’historique et ne contribuent pas à ces dépenses brutes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total gasto mostra despesas planejadas e compras a débito da visualização selecionada. Créditos e ajustes ficam no histórico do cartão e não entram neste total de gastos brutos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“总支出”显示所选视图中的计划支出和借记消费。贷记与调整保留在卡片历史中，不计入此支出原始总额。"
          }
        }
      }
    },
    "Total Spent shows planned expenses and debit purchases for this category in the selected view. Credits and adjustments remain in history and do not contribute to this gross spending total." : {
      "comment" : "A description of the total spent for a category.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض إجمالي الإنفاق النفقات المخططة والمشتريات المسجلة كخصم لهذه الفئة في العرض المحدد. تظل القيود الدائنة والتعديلات في السجل ولا تُحتسب ضمن إجمالي الإنفاق هذا قبل الخصومات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Gesamtausgaben“ zeigt geplante Ausgaben und Debitkäufe für diese Kategorie in der ausgewählten Ansicht. Gutschriften und Anpassungen bleiben im Verlauf erhalten und tragen nicht zu dieser Bruttoausgabensumme bei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total gastado muestra los gastos planificados y las compras a débito de esta categoría en la vista seleccionada. Los abonos y ajustes permanecen en el historial y no se incluyen en este total de gastos brutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total dépensé affiche les dépenses prévues et les achats au débit pour cette catégorie dans la vue sélectionnée. Les crédits et les ajustements restent dans l’historique et ne contribuent pas à ce total brut des dépenses."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total gasto mostra as despesas planejadas e as compras a débito desta categoria na visualização selecionada. Créditos e ajustes permanecem no histórico e não contribuem para este total bruto de gastos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支出总额显示所选视图中此类别的计划费用和借记购买交易。贷记和调整会保留在历史记录中，但不计入此毛支出总额。"
          }
        }
      }
    },
    "Total Variance" : {
      "comment" : "Preset detail calculation help.",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total Variance"
          }
        }
      }
    },
    "Track the metrics you care about most. Home is your dedicated budget dashboard, pin and reorder widgets to your liking. You can also pin select metrics on your iOS/macOS Home Screen." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتبع المقاييس التي تهمك أكثر. الصفحة الرئيسية هي لوحة التحكم المخصصة للميزانية، وتثبيت عناصر واجهة المستخدم وإعادة ترتيبها حسب رغبتك. يمكنك أيضًا تثبيت مقاييس محددة على شاشة iOS/macOS الرئيسية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verfolgen Sie die Kennzahlen, die Ihnen am wichtigsten sind."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Track the metrics you care about most. Home is your dedicated budget dashboard, pin and reorder widgets to your liking. You can also pin select metrics on your iOS/macOS Home Screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sigue las métricas que más te importan. Panel es tu tablero dedicado de presupuesto; fija y reordena widgets a tu gusto. También puedes fijar métricas seleccionadas en la pantalla de inicio de iOS/macOS."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez les indicateurs qui vous importent le plus. Accueil est votre tableau de bord budgétaire dédié ; épinglez et réorganisez les widgets comme vous le souhaitez. Vous pouvez aussi épingler certains indicateurs sur l’écran d’accueil iOS/macOS."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe as métricas que mais lhe interessam. Home é o seu painel de orçamento dedicado, fixe e reordene widgets de acordo com sua preferência. Você também pode fixar métricas selecionadas na tela inicial do iOS/macOS."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "跟踪您最关心的指标。主页是您专用的预算仪表板，可以根据您的喜好固定和重新排序小部件。您还可以将选定的指标固定在 iOS/macOS 主屏幕上。"
          }
        }
      }
    },
    "Track what you owe and what you’re owed." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتبّع ما تدين به وما يدين به الآخرون لك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Behalten Sie im Blick, was Sie schulden und was andere Ihnen schulden."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lleva el control de lo que debes y de lo que te deben."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Suivez ce que vous devez et ce que l’on vous doit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Acompanhe o que você deve e o que devem a você."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "追踪你欠他人和他人欠你的金额。"
          }
        }

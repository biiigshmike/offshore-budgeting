    "Copied or imported periods keep their posted amounts and may need confirmation again in this workspace." : {
      "comment" : "Savings period review and confirmation.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتفظ الفترات المنسوخة أو المستوردة بمبالغها المرحلة، وقد تحتاج إلى تأكيد جديد في مساحة العمل هذه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopierte oder importierte Zeiträume behalten ihre gebuchten Beträge und müssen in diesem Arbeitsbereich möglicherweise erneut bestätigt werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copied or imported periods keep their posted amounts and may need confirmation again in this workspace."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los períodos copiados o importados conservan los importes contabilizados y quizá debas confirmarlos de nuevo en este espacio de trabajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les périodes copiées ou importées conservent leurs montants comptabilisés. Une nouvelle confirmation peut être nécessaire dans cet espace de travail."
          }

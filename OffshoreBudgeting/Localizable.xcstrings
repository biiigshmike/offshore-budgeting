    "After restarting, you can run Reset & Erase Content again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعد إعادة تشغيل التطبيق، يمكنك استخدام «إعادة تعيين ومحو المحتوى» مجددًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nach dem Neustart können Sie „Inhalte zurücksetzen und löschen“ erneut ausführen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Después de reiniciar la app, podrás volver a usar «Restablecer y borrar contenido»."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Après le redémarrage, vous pourrez sélectionner à nouveau « Réinitialiser et effacer le contenu »."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depois de reiniciar o app, você poderá usar “Redefinir e apagar conteúdo” novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重新启动 App 后，你可以再次使用“重置和删除内容”。"
          }
        }
      }
    },
    "All content has been erased. You’ll be returned to onboarding." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",

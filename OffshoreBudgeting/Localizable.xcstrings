    "Minimums are still configured from your presets. Maximums were left unchanged. Turn Auto-Configure off and on to try again." : {
      "comment" : "The body of an alert that appears when the user tries to enable auto-configuration of category goals but the app can't load budget history.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال يتم إعداد الحدود الدنيا من إعداداتك المسبقة. بقيت الحدود القصوى دون تغيير. أوقف الإعداد التلقائي ثم شغّله لإعادة المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindestwerte werden weiterhin anhand deiner Voreinstellungen konfiguriert. Höchstwerte wurden nicht geändert. Schalte die automatische Konfiguration aus und wieder ein, um es erneut zu versuchen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los mínimos siguen configurándose a partir de tus plantillas. Los máximos no se han modificado. Desactiva y vuelve a activar la configuración automática para intentarlo de nuevo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les minimums sont toujours configurés à partir de vos préréglages. Les maximums n’ont pas été modifiés. Désactivez puis réactivez la configuration automatique pour réessayer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os mínimos continuam sendo configurados com base nas suas predefinições. Os máximos não foram alterados. Desative e reative a configuração automática para tentar novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下限仍会根据你的预设配置。上限保持不变。请关闭再开启自动配置以重试。"
          }
        }
      }
    },
    "Missing asset" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الأصول مفقودة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fehlender Vermögenswert"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recurso faltante"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ressource manquante"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recurso ausente"
          }
        },
        "zh-Hans" : {

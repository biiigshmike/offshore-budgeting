    "Pay From Savings" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الدفع من الادخار"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bezahlen Sie mit Ersparnissen"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagar desde ahorros"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payer depuis l’épargne"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pague com poupança"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用储蓄支付"
          }
        }
      }
    },
    "Pay From Savings reduces the available Offshore Savings balance. A credit keeps its full negative budget impact; an adjustment still has zero budget impact. This action does not turn either entry into a purchase." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقلل الدفع من الادخار رصيد Offshore Savings المتاح. يحتفظ الائتمان بكامل أثره السالب على الميزانية؛ ويظل التعديل بلا أثر. ولا يحول هذا الإجراء أيًا من القيدين إلى عملية شراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zahlungen aus Ersparnissen verringern den verfügbaren Saldo von Offshore Savings. Eine Gutschrift behält ihre volle negative Budgetwirkung; eine Anpassung hat weiterhin keine Budgetwirkung. Diese Aktion macht keine der Buchungen zu einem Kauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagar desde ahorros reduce el saldo disponible de Offshore Savings. Un crédito conserva todo su impacto presupuestario negativo; un ajuste sigue sin impacto. Esta acción no convierte ninguna de estas entradas en una compra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Payer depuis l’épargne réduit le solde disponible d’Offshore Savings. Un crédit conserve tout son impact budgétaire négatif ; un ajustement garde un impact nul. Cette action ne transforme aucune de ces écritures en achat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pagar com poupança reduz o saldo disponível de Offshore Savings. Um crédito mantém todo o impacto negativo no orçamento; um ajuste continua sem impacto. Essa ação não transforma nenhum desses lançamentos em compra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“用储蓄支付”会减少可用的 Offshore Savings 余额。贷记仍保留全部负向预算影响，调整仍不影响预算。此操作不会将这两类记录变为消费。"
          }
        }
      }
    },

        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre pourboire est en attente d’approbation. Merci ! Apple finalisera l’achat après approbation."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua contribuição está aguardando aprovação. Obrigado! A Apple vai concluí-la assim que for aprovada."

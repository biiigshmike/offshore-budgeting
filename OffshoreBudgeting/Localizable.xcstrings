        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些是附近的地点。请只在确实有消费时选择地点。"
          }
        }
      }
    },
    "These planned expenses have actual spending recorded." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه النفقات المخططة لها إنفاق فعلي مسجل."

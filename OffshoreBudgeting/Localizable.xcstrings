    "What happened?\n\nWhat did you expect?\n\nWhat steps led to the problem?" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ماذا حدث؟\n\nماذا كنت تتوقع؟\n\nما الخطوات التي أدت إلى المشكلة؟"
          }
        },
        "de" : {
          "stringUnit" : {

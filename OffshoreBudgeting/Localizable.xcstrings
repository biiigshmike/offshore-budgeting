          }
        }
      }
    },
    "Use Workspaces to keep contexts separate and prevent cross-domain data mixing." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم مساحات العمل لإبقاء السياقات منفصلة ومنع خلط البيانات عبر النطاقات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie Arbeitsbereiche, um Kontexte getrennt zu halten und eine domänenübergreifende Datenvermischung zu verhindern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Workspaces to keep contexts separate and prevent cross-domain data mixing."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Espacios de trabajo para mantener los contextos separados y evitar mezclar datos entre dominios."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez les Espaces de travail pour garder les contextes séparés et éviter le mélange de données entre domaines."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use espaços de trabalho para manter os contextos separados e evitar a mistura de dados entre domínios."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用工作区保持上下文分离并防止跨域数据混合。"
          }
        }
      }
    },
    "Uses Apple Intelligence for richer merchant naming when available." : {
      "comment" : "Description of a shortcut link variant that uses Apple Intelligence for richer merchant naming when available.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Apple Intelligence للحصول على تسمية أغنى للتاجر عند توفره."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet Apple Intelligence für aussagekräftigere Händlernamen, wenn verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Apple Intelligence para nombres de comercios más completos cuando está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise Apple Intelligence pour des noms de commerçants plus riches lorsqu’il est disponible."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Apple Intelligence para nomes de comerciantes mais ricos quando disponível."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在可用时使用 Apple Intelligence 来生成更丰富的商户名称。"
          }
        }
      }
    },
    "Uses Apple Intelligence for richer source naming when available." : {
      "comment" : "\"Apple Intelligence\" is a feature that uses machine learning to automatically identify and categorize data sources, such as email addresses or phone numbers, into more human-readable formats.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Apple Intelligence للحصول على تسمية أغنى للمصدر عند توفره."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwendet Apple Intelligence für aussagekräftigere Quellennamen, wenn verfügbar."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Apple Intelligence para nombres de fuente más completos cuando está disponible."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise Apple Intelligence pour des noms de source plus riches lorsqu’il est disponible."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Apple Intelligence para nomes de origem mais ricos quando disponível."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在可用时使用 Apple Intelligence 来生成更丰富的来源名称。"
          }
        }
      }
    },
    "Using Pay From Savings reduces your available savings. The full expense stays in your card history." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدام «الدفع من الادخار» يقلل الادخار المتاح. وتظل النفقة كاملة في سجل بطاقتك."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Bezahlen Sie mit Ersparnissen“ verringert Ihre verfügbaren Ersparnisse. Die vollständige Ausgabe bleibt im Kartenverlauf."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar Pagar desde ahorros reduce tus ahorros disponibles. El gasto completo permanece en el historial de tu tarjeta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utiliser Payer depuis l’épargne réduit votre épargne disponible. La dépense entière reste dans l’historique de votre carte."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usar “Pague com poupança” reduz sua poupança disponível. A despesa completa permanece no histórico do cartão."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {

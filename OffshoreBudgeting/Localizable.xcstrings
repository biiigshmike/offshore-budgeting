    "Choose a CSV, PDF, or image from Files or Photos to begin." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ملف CSV أو PDF أو صورة من «الملفات» أو «الصور» للبدء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie aus „Dateien“ oder „Fotos“ eine CSV-Datei, eine PDF-Datei oder ein Bild aus."

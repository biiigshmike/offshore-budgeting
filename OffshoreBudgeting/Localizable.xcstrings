    "The five most recent launches are retained in this app’s sandbox. Each log is limited to 1 MB and remains available when Xcode’s console is disconnected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتفظ التطبيق بسجلات عمليات التشغيل الخمس الأخيرة في مساحة التخزين المعزولة الخاصة به. الحد الأقصى لكل سجل هو ١ ميغابايت، ويظل متاحًا حتى بعد قطع اتصال وحدة تحكّم Xcode."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Protokolle der letzten fünf Starts bleiben in der Sandbox dieser App verfügbar. Jedes Protokoll ist auf 1 MB begrenzt und lässt sich auch ohne Verbindung zur Xcode-Konsole abrufen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los cinco inicios más recientes se conservan en el entorno aislado de la app. Cada registro tiene un límite de 1 MB y sigue disponible cuando la consola de Xcode se desconecta."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les journaux des cinq derniers lancements sont conservés dans l’espace isolé de cette app. Chaque journal est limité à 1 Mo et reste accessible même quand la console Xcode est déconnectée."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As cinco inicializações mais recentes ficam armazenadas no ambiente isolado do app. Cada registro tem limite de 1 MB e continua disponível quando o console do Xcode está desconectado."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最近五次启动的日志保存在此 App 的沙盒中。每份日志最多 1 MB，即使断开 Xcode 控制台的连接也仍可查看。"
          }
        }
      }
    },

    "Total Spent follows the view you selected: Planned, Combined, or Variable." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتبع إجمالي الإنفاق العرض الذي اخترته: مخطط أو مجمع أو متغير."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gesamtausgaben folgen Ihrer ausgewählten Ansicht: „Geplant“, „Kombiniert“ oder „Variabel“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total gastado sigue la vista que has seleccionado: Planificado, Combinado o Variable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total dépensé suit la vue que vous avez sélectionnée : Prévu, Combiné ou Variable."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Total gasto segue a visualização selecionada: Planejado, Combinado ou Variável."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "总花费随你选择的视图变化：计划、合并或可变。"
          }
        }
      }
    },
    "Total Spent includes both Planned expenses and purchases entered as Variable Expenses." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشمل إجمالي الإنفاق النفقات المخططة والمشتريات المدخلة كنفقات متغيرة معًا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gesamtausgaben enthalten sowohl geplante Ausgaben als auch als „Variable Ausgaben“ eingegebene Käufe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total gastado incluye tanto los gastos planificados como las compras introducidas como Gastos variables."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total dépensé inclut les dépenses prévues et les achats saisis comme Dépenses variables."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Total gasto inclui despesas planejadas e compras registradas como Despesas Variáveis."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "总花费同时包含计划费用和作为可变费用录入的购买金额。"
          }
        }
      }
    },
    "Total Spent shows only Planned expenses because that is the view you selected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض إجمالي الإنفاق النفقات المخططة فقط، لأن هذا هو العرض الذي اخترته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gesamtausgaben zeigen nur geplante Ausgaben, weil Sie diese Ansicht ausgewählt haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total gastado solo muestra los gastos planificados porque es la vista que has seleccionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total dépensé affiche uniquement les dépenses prévues, car c’est la vue que vous avez sélectionnée."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Total gasto mostra apenas despesas planejadas porque essa é a visualização selecionada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "总花费只显示计划费用，因为你选择了该视图。"
          }
        }
      }
    },
    "Total Spent shows only purchases entered as Variable Expenses because that is the view you selected." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض إجمالي الإنفاق المشتريات المدخلة كنفقات متغيرة فقط، لأن هذا هو العرض الذي اخترته."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Gesamtausgaben zeigen nur als „Variable Ausgaben“ eingegebene Käufe, weil Sie diese Ansicht ausgewählt haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total gastado solo muestra las compras introducidas como Gastos variables porque es la vista que has seleccionado."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total dépensé affiche uniquement les achats saisis comme Dépenses variables, car c’est la vue que vous avez sélectionnée."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Total gasto mostra apenas compras registradas como Despesas Variáveis porque essa é a visualização selecionada."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "总花费只显示作为可变费用录入的购买金额，因为你选择了该视图。"
          }
        }
      }
    },
    "Total Spent shows planned expenses and debit purchases for the selected view. Credits and adjustments remain in card history and do not contribute to this gross spending total." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض إجمالي الإنفاق المصروفات المخططة ومشتريات الخصم للعرض المحدد. تبقى المبالغ الدائنة والتعديلات في سجل البطاقة ولا تُحتسب ضمن إجمالي الإنفاق قبل الخصومات هنا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gesamtausgaben zeigt geplante Ausgaben und Kaufbelastungen der gewählten Ansicht. Gutschriften und Anpassungen bleiben im Kartenverlauf und zählen nicht zu dieser Bruttoausgabensumme."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El total gastado muestra gastos planificados y compras de débito para la vista seleccionada. Los créditos y ajustes permanecen en el historial y no contribuyen a este gasto bruto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le total dépensé affiche les dépenses prévues et achats débités de la vue sélectionnée. Les crédits et ajustements restent dans l’historique et ne contribuent pas à ces dépenses brutes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total gasto mostra despesas planejadas e compras a débito da visualização selecionada. Créditos e ajustes ficam no histórico do cartão e não entram neste total de gastos brutos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“总支出”显示所选视图中的计划支出和借记消费。贷记与调整保留在卡片历史中，不计入此支出原始总额。"
          }
        }
      }
    },
    "Total Spent shows planned expenses and debit purchases for this category in the selected view. Credits and adjustments remain in history and do not contribute to this gross spending total." : {
      "comment" : "A description of the total spent for a category.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعرض إجمالي الإنفاق النفقات المخططة والمشتريات المسجلة كخصم لهذه الفئة في العرض المحدد. تظل القيود الدائنة والتعديلات في السجل ولا تُحتسب ضمن إجمالي الإنفاق هذا قبل الخصومات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Gesamtausgaben“ zeigt geplante Ausgaben und Debitkäufe für diese Kategorie in der ausgewählten Ansicht. Gutschriften und Anpassungen bleiben im Verlauf erhalten und tragen nicht zu dieser Bruttoausgabensumme bei."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total gastado muestra los gastos planificados y las compras a débito de esta categoría en la vista seleccionada. Los abonos y ajustes permanecen en el historial y no se incluyen en este total de gastos brutos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total dépensé affiche les dépenses prévues et les achats au débit pour cette catégorie dans la vue sélectionnée. Les crédits et les ajustements restent dans l’historique et ne contribuent pas à ce total brut des dépenses."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Total gasto mostra as despesas planejadas e as compras a débito desta categoria na visualização selecionada. Créditos e ajustes permanecem no histórico e não contribuem para este total bruto de gastos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支出总额显示所选视图中此类别的计划费用和借记购买交易。贷记和调整会保留在历史记录中，但不计入此毛支出总额。"
          }
        }
      }
    },

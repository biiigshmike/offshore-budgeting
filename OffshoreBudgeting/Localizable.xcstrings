    "Progress compares Actual Income with Planned Income. A percentage is shown when Planned Income is greater than zero." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقارن التقدم الدخل الفعلي بالمخطط. وتظهر نسبة مئوية عندما يكون الدخل المخطط أكبر من صفر."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Fortschritt vergleicht tatsächliche mit geplanten Einnahmen. Ein Prozentsatz erscheint, wenn geplante Einnahmen größer als null sind."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El progreso compara los ingresos reales con los planificados. Se muestra un porcentaje cuando los ingresos planificados son mayores que cero."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La progression compare le revenu réel au revenu prévu. Un pourcentage apparaît lorsque le revenu prévu est supérieur à zéro."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O progresso compara a renda real com a planejada. Uma porcentagem aparece quando a renda planejada é maior que zero."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "进度用于比较实际收入与计划收入。计划收入大于零时会显示百分比。"
          }
        }
      }
    },
    "Projected" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المتوقع"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projiziert"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Proyectado"
          }
        },

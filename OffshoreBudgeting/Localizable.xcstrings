            "value" : "يجب أن يكون المبلغ المدفوع من الادخار 0 أو أكبر، ولا يمكن أن يتجاوز المبلغ المخطط له."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der aus Ersparnissen bezahlte Betrag muss mindestens 0 sein und darf den geplanten Betrag nicht überschreiten."
          }
        },
        "es" : {
          "stringUnit" : {

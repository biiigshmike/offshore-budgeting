    },
    "These places were nearby. Choose a place only if you made a purchase." : {
      "comment" : "A description of the list of places that the user can choose from.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "كانت هذه الأماكن قريبة منك. اختر مكانًا فقط إذا أجريت عملية شراء فيه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Orte waren in Ihrer Nähe. Wählen Sie nur dann einen Ort aus, wenn Sie etwas gekauft haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estos lugares estaban cerca. Elige uno solo si hiciste una compra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ces lieux se trouvaient à proximité. Choisissez un lieu seulement si vous y avez fait un achat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",

    "budgets.tip.viewSort.detail" : {
      "comment" : "Tip detail explaining budget buckets.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "نشط • يحدث الآن\nالقادمة • يبدأ في وقت لاحق\nالماضي • انتهى"

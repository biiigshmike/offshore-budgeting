    "Some details changed since your last review. Take another look before updating Savings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّرت بعض التفاصيل منذ آخر مراجعة. راجعها قبل تحديث المدخرات."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seit deiner letzten Prüfung haben sich einige Angaben geändert. Prüfe sie erneut, bevor du die Ersparnisse aktualisierst."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some details changed since your last review. Take another look before updating Savings."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos datos cambiaron desde la última revisión. Revísalos antes de actualizar Ahorros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines données ont changé depuis votre dernière vérification. Vérifiez-les avant d’actualiser l’épargne."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns dados mudaram desde a última revisão. Confira-os antes de atualizar a Poupança."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "上次审核后有些明细发生了变化。更新储蓄前请再检查一次。"
          }
        }
      }
    },
    "Some details changed while you were here. Check the updated totals and try again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تغيّرت بعض التفاصيل أثناء المراجعة. تحقّق من الإجماليات المحدّثة ثم أعد المحاولة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Angaben haben sich während der Prüfung geändert. Prüfe die aktualisierten Summen und versuche es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some details changed while you were here. Check the updated totals and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos datos cambiaron durante la revisión. Comprueba los totales actualizados y vuelve a intentarlo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines données ont changé pendant votre vérification. Consultez les totaux actualisés, puis réessayez."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alguns dados mudaram durante a revisão. Confira os totais atualizados e tente novamente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "审核期间有些明细发生了变化。请检查更新后的总额，然后重试。"
          }
        }
      }
    },
    "Some expenses are still using their planned amounts. You can update them below." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا تزال بعض النفقات تُحتسب بمبالغها المخططة. يمكنك تحديثها أدناه."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige Ausgaben gehen noch mit ihren geplanten Beträgen ein. Du kannst sie unten aktualisieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some expenses are still using their planned amounts. You can update them below."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunos gastos aún se calculan con los importes planificados. Puedes actualizarlos abajo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines dépenses sont encore comptées à leur montant prévu. Vous pouvez les actualiser ci-dessous."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algumas despesas ainda usam os valores planejados. Você pode atualizá-las abaixo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "部分费用仍按计划金额计算。你可以在下方更新。"
          }
        }
      }
    },
    "Some of these dates are already included in Savings. Check the other period first so nothing gets counted twice." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بعض هذه التواريخ مشمولة بالفعل في المدخرات. راجع الفترة الأخرى أولًا لتجنّب احتساب أي مبلغ مرتين."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Einige dieser Tage sind bereits in den Ersparnissen berücksichtigt. Prüfe zuerst den anderen Zeitraum, damit nichts doppelt gezählt wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Some of these dates are already included in Savings. Check the other period first so nothing gets counted twice."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algunas de estas fechas ya están incluidas en Ahorros. Revisa primero el otro período para evitar contabilizar algo dos veces."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Certaines de ces dates sont déjà prises en compte dans l’épargne. Vérifiez d’abord l’autre période pour éviter tout double comptage."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Algumas dessas datas já estão incluídas na Poupança. Confira o outro período primeiro para evitar contagem em duplicidade."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "其中一些日期已计入储蓄。请先检查另一期间，以免重复计算。"
          }
        }
      }
    },
    "Some planned expenses from this preset have recorded spending. Review them below if you want to delete any." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم تسجيل بعض النفقات المخططة من هذا الإعداد المسبق. قم بمراجعتها أدناه إذا كنت تريد حذف أي منها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Für einige geplante Ausgaben aus dieser Voreinstellung wurden Ausgaben erfasst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",

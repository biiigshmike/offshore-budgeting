          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Offshore additionne les Dépenses prévues et les Dépenses variables de cette catégorie après avoir retiré les montants des dépenses partagées, Payer depuis l’épargne et les remboursements."

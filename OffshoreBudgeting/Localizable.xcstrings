    "Select the cards and any presets before saving. Check the generated planned expenses in Budget Details afterward." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "حدد البطاقات والإعدادات المسبقة المطلوبة قبل الحفظ. تحقق بعد ذلك من النفقات المخططة التي تم إنشاؤها في «تفاصيل الميزانية»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie vor dem Speichern die Karten und gegebenenfalls Voreinstellungen aus. Prüfen Sie anschließend die erzeugten geplanten Ausgaben in den „Budgetdetails“."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecciona las tarjetas y las plantillas que quieras usar antes de guardar. Luego comprueba los gastos planificados generados en Detalles del presupuesto."
          }

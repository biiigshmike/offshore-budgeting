    "This would create more than 10,000 planned expenses. Reduce the number of budgets or the cycle interval." : {
      "comment" : "Error message displayed when creating budgets would result in more than 10,000 planned expenses.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي ذلك إلى إنشاء أكثر من ١٠٬٠٠٠ نفقة مخططة. قلّل عدد الميزانيات أو مدة الدورة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch würden mehr als 10.000 geplante Ausgaben erstellt. Verringern Sie die Anzahl der Budgets oder das Wiederholungsintervall."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esto crearía más de 10.000 gastos planificados. Reduce el número de presupuestos o el intervalo del ciclo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",

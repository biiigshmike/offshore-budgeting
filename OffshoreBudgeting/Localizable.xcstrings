    "Feedback drafts include the app version and operating system. Your financial records are not attached." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تتضمن مسودات الملاحظات إصدار التطبيق ونظام التشغيل. ولا تُرفق سجلاتك المالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Feedback-Entwürfe enthalten App-Version und Betriebssystem. Ihre Finanzdaten werden nicht angehängt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los borradores incluyen la versión de la app y el sistema operativo. No se adjuntan tus registros financieros."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les brouillons incluent la version de l’app et le système d’exploitation. Vos données financières ne sont pas jointes."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os rascunhos incluem a versão do app e o sistema operacional. Seus registros financeiros não são anexados."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "反馈草稿包含应用版本和操作系统，不会附加你的财务记录。"

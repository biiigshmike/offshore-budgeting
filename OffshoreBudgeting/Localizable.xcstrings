    "Near %@? Record an expense if you made a purchase." : {
      "comment" : "Text displayed in a notification when a user is near a specific merchant and can record an expense. The argument is the merchant name.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هل أنت بالقرب من %@؟ سجّل نفقة إذا أجريت عملية شراء."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In der Nähe von %@? Erfassen Sie Ihre Ausgabe, falls Sie etwas gekauft haben."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Estás cerca de %@? Registra un gasto si hiciste una compra."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Près de %@ ? Enregistrez une dépense si vous avez fait un achat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Perto de %@? Registre uma despesa se fez uma compra."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在 %@ 附近吗？如果有消费，记得记录一笔支出。"
          }
        }
      }
    },
    "Near a few places? Record an expense if you made a purchase." : {
      "comment" : "Text displayed in a notification when the user is near a few places and can record an expense.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",

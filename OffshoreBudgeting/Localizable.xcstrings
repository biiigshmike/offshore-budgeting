    "Opens Manage Presets." : {
      "comment" : "Preset detail and preset row presentation.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح شاشة «إدارة الإعدادات المسبقة»."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffnet „Voreinstellungen verwalten“."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opens Manage Presets."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre «Administrar plantillas»."
          }
        },

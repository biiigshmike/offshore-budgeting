        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下载你想与 Offshore 一起使用的任何快捷指令链接。这里的所有内容都是可选的，你也可以稍后在“设置”中安装。"
          }

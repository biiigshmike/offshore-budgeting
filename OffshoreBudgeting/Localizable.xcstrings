        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este y futuros"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celle-ci et les suivantes"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Isto e o futuro"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在与未来"
          }
        }
      }
    },
    "This Apple ID can sync existing Offshore data from iCloud. You can always switch later from Manage Workspaces." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكن لمعرف Apple هذا مزامنة بيانات Offshore الموجودة من iCloud. يمكنك دائمًا التبديل لاحقًا من إدارة مساحات العمل."
          }
        },

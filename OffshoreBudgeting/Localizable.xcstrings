    "General" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "عام"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Allgemein"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "General"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "General"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Général"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Em geral"
          }
        },
        "zh-Hans" : {

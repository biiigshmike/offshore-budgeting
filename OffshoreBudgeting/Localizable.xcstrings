          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces para ocultar los gastos de este periodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez deux fois pour masquer les dépenses de cette période."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes para ocultar as despesas deste período."

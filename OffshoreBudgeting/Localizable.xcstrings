    "Spending by Category" : {
      "comment" : "Section title for the spending by category section in the spending calculation.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الإنفاق حسب الفئة"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ausgaben nach Kategorie"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gasto por categoría"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dépenses par catégorie"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gastos por categoria"
          }
        },
        "zh-Hans" : {

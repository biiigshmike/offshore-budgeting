    "Use iCloud to sync your workspaces and budgets across your devices signed into this Apple ID." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم iCloud لمزامنة مساحات العمل والميزانيات الخاصة بك عبر أجهزتك المسجلة في معرف Apple هذا."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie iCloud, um Ihre Arbeitsbereiche und Budgets auf allen Ihren mit dieser Apple-ID angemeldeten Geräten zu synchronisieren."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa iCloud para sincronizar tus espacios de trabajo y presupuestos entre tus dispositivos con este Apple ID."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez iCloud pour synchroniser vos espaces de travail et vos budgets sur vos appareils connectés avec cet identifiant Apple."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use iCloud para sincronizar seus espaços de trabalho e orçamentos em todos os dispositivos conectados a este ID Apple."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 iCloud 在登录此 Apple ID 的设备之间同步工作区和预算。"
          }
        }
      }
    },
    "Use Offshore Savings Outlook to forecast direction and course-correct before period close." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم توقعات Offshore Savings لاستشراف الاتجاه وتصحيح المسار قبل إغلاق الفترة."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie den Offshore Savings-Ausblick, um die Entwicklung abzuschätzen und vor Periodenende gegenzusteuern."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la Perspectiva de Offshore Savings para prever la dirección y corregir el rumbo antes del cierre del periodo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez les Perspectives Offshore Savings pour anticiper la tendance et ajuster le cap avant la clôture de la période."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use a Projeção do Offshore Savings para prever a direção e corrigir o rumo antes do encerramento do período."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Offshore Savings 展望预测趋势，并在期末前及时调整。"
          }
        }
      }
    },
    "Use Offshore Savings to track money left over at the end of each budgeting period." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم Offshore Savings لتتبع الأموال المتبقية في نهاية كل فترة ميزانية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verwenden Sie Offshore Savings, um das Geld zu verfolgen, das am Ende jeder Budgetperiode übrig bleibt."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Offshore Savings para registrar el dinero que sobra al final de cada periodo de presupuesto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Offshore Savings pour suivre l’argent restant à la fin de chaque période budgétaire."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o Offshore Savings para acompanhar o dinheiro que sobra ao final de cada período orçamentário."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用 Offshore Savings 记录每个预算期结束时剩余的资金。"
          }
        }
      }
    },
    "Use Pay From Savings to cover part or all of an expense from this balance. The full transaction stays in your card history; only the remaining amount affects the current period’s budget." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم الدفع من الادخار لتغطية جزء من مصروف أو كله من هذا الرصيد. تبقى المعاملة كاملة في سجل البطاقة؛ ويؤثر المبلغ المتبقي فقط على ميزانية الفترة الحالية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzen Sie Zahlungen aus Ersparnissen, um Ausgaben ganz oder teilweise aus diesem Saldo zu decken. Die vollständige Buchung bleibt im Kartenverlauf; nur der Rest belastet den aktuellen Zeitraum."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Pagar desde ahorros para cubrir parte o todo un gasto con este saldo. La transacción completa permanece en el historial; solo el resto afecta al presupuesto actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez Payer depuis l’épargne pour couvrir tout ou partie d’une dépense avec ce solde. La transaction entière reste dans l’historique ; seul le reste affecte le budget actuel."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Pagar com poupança para cobrir parte ou toda uma despesa com este saldo. A transação completa fica no histórico; apenas o restante afeta o orçamento do período atual."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用“用储蓄支付”，以此余额支付部分或全部支出。完整交易保留在卡片历史中，只有剩余金额影响当前周期预算。"
          }
        }
      }
    },
    "Use Presets management to keep recurring templates accurate and ready." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم إدارة الإعدادات المسبقة للحفاظ على دقة القوالب المتكررة وجاهزيتها."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nutzen Sie die Voreinstellungsverwaltung, um wiederkehrende Vorlagen korrekt und bereit zu halten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use Presets management to keep recurring templates accurate and ready."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la gestión de Plantillas para mantener listas y precisas las plantillas recurrentes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez la gestion des Préréglages pour garder les modèles récurrents exacts et prêts."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use o gerenciamento de predefinições para manter os modelos recorrentes precisos e prontos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用预设管理来保持重复模板的准确性和就绪性。"
          }
        }
      }
    },
    "Use Reconciliations to track shared balances separately from normal card spending." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم التسويات لتتبع الأرصدة المشتركة بشكل منفصل عن الإنفاق العادي بالبطاقة."

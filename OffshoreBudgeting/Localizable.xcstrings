        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un adiós a Marina, por ahora"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Au revoir Marina, pour le moment"

    },
    "Extra Cushion adds your chosen percentage to the historical average before suggesting a maximum. Set it to zero to add no cushion." : {
      "comment" : "Explains how Extra Cushion affects suggested category maximums.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يضيف الهامش الإضافي النسبة التي تختارها إلى المتوسط التاريخي قبل اقتراح حد أقصى. اضبطه على صفر لعدم إضافة هامش."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der zusätzliche Puffer erhöht den historischen Durchschnitt um den gewählten Prozentsatz, bevor ein Höchstwert vorgeschlagen wird. Setze ihn auf null, um keinen Puffer hinzuzufügen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El margen adicional suma el porcentaje que elijas a la media histórica antes de sugerir un máximo. Establécelo en cero para no añadir margen."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La marge supplémentaire ajoute le pourcentage choisi à la moyenne historique avant de suggérer un maximum. Réglez-la sur zéro pour ne pas ajouter de marge."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A margem extra acrescenta a porcentagem escolhida à média histórica antes de sugerir um máximo. Defina-a como zero para não acrescentar margem."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "额外余量会在建议上限前，将你选择的百分比加到历史平均值上。设为零则不添加余量。"
          }
        }
      }
    },

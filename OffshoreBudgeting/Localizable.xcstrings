        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sélectionnez les cartes et les éventuels préréglages avant d’enregistrer. Vérifiez ensuite les dépenses prévues générées dans « Détails du budget »."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selecione os cartões e as predefinições que deseja usar antes de salvar. Depois, confira as despesas planejadas geradas em Detalhes do orçamento."

    "homeEdit.footer.phoneTileSize" : {
      "comment" : "Footnote explaining when Home widget size choices take effect on iPhone.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تُطبّق خيارات الحجم في الوضع الأفقي عند توفر مساحة كافية. تظل الأدوات مكدسة في الوضع الرأسي."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Größenauswahl gilt im Querformat, wenn genügend Platz vorhanden ist. Im Hochformat bleiben Widgets untereinander angeordnet."
          }
        },
